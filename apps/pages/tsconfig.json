{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "paths": {
      "@cloud/*": [
        "../notebook-cloud/src/*"
      ],
      "@nteract/identity": [
        "../../packages/identity/src/index.ts"
      ],
      "@nteract/local-oidc": [
        "../../packages/local-oidc/src/index.ts"
      ],
      "jose": [
        "./node_modules/jose/dist/webapi/index.js"
      ],
      "dompurify": [
        "./node_modules/dompurify/dist/purify.es.mjs"
      ],
      "pele": [
        "./node_modules/pele/dist/pele.js"
      ]
    }
  }
}
