{
  "machine": "editor-start",
  "description": "When the viewer asks for the Page editor ahead of an open. A route that opens a document starts it at boot; a listing route holds it until its first rows paint, the first screen's card images settle (or a cap runs out) and the browser is idle, or until a pointer or focus shows intent to open a Page. An open that starts the loader itself ends the wait. Runs against viewer/editor-start-machine.mjs in viewer/editor-start.test.mjs.",
  "states": [
    "booting",
    "holding",
    "settling",
    "idling",
    "started"
  ],
  "events": [
    "boot",
    "painted",
    "settled",
    "idle",
    "intent",
    "opened"
  ],
  "unreachable": [
    [
      "booting",
      "painted",
      "The row watcher attaches at boot"
    ],
    [
      "booting",
      "settled",
      "The image watcher attaches after the rows paint"
    ],
    [
      "booting",
      "idle",
      "The idle callback is requested only after the rows paint"
    ],
    [
      "booting",
      "intent",
      "The intent listeners attach at boot"
    ],
    [
      "booting",
      "opened",
      "Nothing opens a Page before the route is read"
    ],
    [
      "holding",
      "settled",
      "The image watcher attaches after the rows paint"
    ],
    [
      "holding",
      "idle",
      "The idle callback is requested only after the rows paint"
    ],
    [
      "settling",
      "idle",
      "The idle callback is requested only once the images settle"
    ]
  ],
  "cases": {
    "booting/boot": [
      "listing",
      "document"
    ],
    "holding/painted": [
      "cards",
      "no-cards"
    ]
  },
  "rows": [
    {
      "label": "a listing route holds the editor and watches for rows and intent",
      "note": "/, /pages and /projects.",
      "case": "listing",
      "state": {
        "name": "booting"
      },
      "event": {
        "type": "boot",
        "route": "home"
      },
      "expect": {
        "state": {
          "name": "holding"
        },
        "effects": [
          {
            "type": "watch"
          }
        ]
      }
    },
    {
      "label": "a route that opens a document starts the editor at boot",
      "note": "/p/<id>, Project content, legacy ?page= links and unknown paths. The WASM preload keeps its default priority.",
      "case": "document",
      "state": {
        "name": "booting"
      },
      "event": {
        "type": "boot",
        "route": "page"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "start"
          }
        ]
      }
    },
    {
      "label": "a holding route reads its route once",
      "state": {
        "name": "holding"
      },
      "event": {
        "type": "boot",
        "route": "page"
      },
      "expect": {
        "state": {
          "name": "holding"
        },
        "effects": [],
        "rejected": "The route was already read"
      }
    },
    {
      "label": "grid rows painted with cards on the first screen: wait for their images",
      "note": "The editor chunk and the WASM would share the link with the first card images.",
      "case": "cards",
      "state": {
        "name": "holding"
      },
      "event": {
        "type": "painted",
        "cards": 10
      },
      "expect": {
        "state": {
          "name": "settling"
        },
        "effects": [
          {
            "type": "settle"
          }
        ]
      }
    },
    {
      "label": "list rows, or an empty grid, painted: go straight to the idle wait",
      "case": "no-cards",
      "state": {
        "name": "holding"
      },
      "event": {
        "type": "painted",
        "cards": 0
      },
      "expect": {
        "state": {
          "name": "idling"
        },
        "effects": [
          {
            "type": "idle"
          }
        ]
      }
    },
    {
      "label": "intent before the rows paint starts the editor at once",
      "note": "A pointer or focus on New Page or the Page switcher while the list loads.",
      "state": {
        "name": "holding"
      },
      "event": {
        "type": "intent"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "start"
          },
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "a Page opened before the rows paint removes the watchers",
      "note": "An empty library's New Page, or a keyboard open: the loader already started.",
      "state": {
        "name": "holding"
      },
      "event": {
        "type": "opened"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "a settling route reads its route once",
      "state": {
        "name": "settling"
      },
      "event": {
        "type": "boot",
        "route": "home"
      },
      "expect": {
        "state": {
          "name": "settling"
        },
        "effects": [],
        "rejected": "The route was already read"
      }
    },
    {
      "label": "rows that paint again while images settle change nothing",
      "state": {
        "name": "settling"
      },
      "event": {
        "type": "painted",
        "cards": 4
      },
      "expect": {
        "state": {
          "name": "settling"
        },
        "effects": [],
        "rejected": "The first rows already painted"
      }
    },
    {
      "label": "the first-screen images settled: wait for the browser to be idle",
      "note": "Each image loaded or failed, or the cap ran out.",
      "state": {
        "name": "settling"
      },
      "event": {
        "type": "settled"
      },
      "expect": {
        "state": {
          "name": "idling"
        },
        "effects": [
          {
            "type": "idle"
          }
        ]
      }
    },
    {
      "label": "intent while images load starts the editor at once",
      "state": {
        "name": "settling"
      },
      "event": {
        "type": "intent"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "start"
          },
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "a Page opened while images load removes the watchers",
      "state": {
        "name": "settling"
      },
      "event": {
        "type": "opened"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "an idling route reads its route once",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "boot",
        "route": "home"
      },
      "expect": {
        "state": {
          "name": "idling"
        },
        "effects": [],
        "rejected": "The route was already read"
      }
    },
    {
      "label": "rows that paint again while idling change nothing",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "painted",
        "cards": 0
      },
      "expect": {
        "state": {
          "name": "idling"
        },
        "effects": [],
        "rejected": "The first rows already painted"
      }
    },
    {
      "label": "a late settle, from the cap after the images, asks for nothing",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "settled"
      },
      "expect": {
        "state": {
          "name": "idling"
        },
        "effects": [],
        "rejected": "The first-screen images already settled"
      }
    },
    {
      "label": "the browser is idle: start the editor with the WASM at low priority",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "idle"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "start",
            "priority": "low"
          },
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "intent before the idle callback starts the editor at once",
      "note": "At normal priority: the stop cancels the pending idle callback.",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "intent"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "start"
          },
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "a Page opened before the idle callback removes the watchers",
      "state": {
        "name": "idling"
      },
      "event": {
        "type": "opened"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [
          {
            "type": "stop"
          }
        ]
      }
    },
    {
      "label": "a started editor reads no route",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "boot",
        "route": "home"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The route was already read"
      }
    },
    {
      "label": "rows painting after the start change nothing",
      "note": "A Page route that later shows the library.",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "painted",
        "cards": 3
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The editor was already asked for"
      }
    },
    {
      "label": "a late settle asks for nothing",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "settled"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The editor was already asked for"
      }
    },
    {
      "label": "a late idle callback asks for nothing",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "idle"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The editor was already asked for"
      }
    },
    {
      "label": "intent after the start asks for nothing",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "intent"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The editor was already asked for"
      }
    },
    {
      "label": "the loader reporting a start this machine asked for changes nothing",
      "note": "The boot, idle and intent starts reach the loader, which reports back.",
      "state": {
        "name": "started"
      },
      "event": {
        "type": "opened"
      },
      "expect": {
        "state": {
          "name": "started"
        },
        "effects": [],
        "rejected": "The editor was already asked for"
      }
    }
  ]
}
