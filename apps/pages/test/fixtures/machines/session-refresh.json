      "state": {
        "name": "superseded",
        "keepAlive": true,
        "signedIn": true,
        "failingSince": 5000
      },
      "event": {
        "type": "settled",
        "outcome": "unreachable",
        "at": 30000
      },
      "expect": {
        "state": {
          "name": "requesting",
          "keepAlive": true,
          "signedIn": true,
          "failingSince": 5000
        },
        "effects": [
          {
            "type": "request"
          }
        ]
      }
    },
    {
