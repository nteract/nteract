      "state": {
        "name": "stopped"
      },
      "event": {
        "type": "refresh",
        "reason": "retry"
      },
      "expect": {
        "state": {
          "name": "stopped"
        },
        "effects": [],
        "rejected": "Session maintenance stopped"
      }
    },
    {
      "label": "a request in flight at stop answers only its waiters",
      "state": {
        "name": "stopped"
      },
      "event": {
        "type": "settled",
        "outcome": "signedIn"
      },
      "expect": {
        "state": {
          "name": "stopped"
        },
        "effects": [
          {
            "type": "answer"
          }
        ]
      }
    },
    {
      "label": "stopping twice",
      "state": {
        "name": "stopped"
      },
      "event": {
        "type": "stop"
      },
      "expect": {
        "state": {
          "name": "stopped"
        },
        "effects": [],
        "rejected": "Session maintenance stopped"
      }
    }
  ]
}
