{
  "machine": "comments-open",
  "description": "Opening a Page's comments document on a replica: lookups with a timeout, bounded retries, a visible failure, and restarts on reconnect or replica replacement (viewer/comments-open-machine.mjs).",
  "states": [
    "closed",
    "opening",
    "ready",
    "retrying",
    "failed"
  ],
  "events": [
    "open",
    "opened",
    "lookupFailed",
    "timer",
    "reconnected",
    "retry",
    "close"
  ],
  "unreachable": [],
  "cases": {
    "opening/opened": [
      "current",
      "stale"
    ],
    "opening/lookupFailed": [
      "retry",
      "exhausted",
      "stale"
    ],
    "retrying/timer": [
      "current",
      "stale"
    ],
    "closed/open": [
      "new"
    ],
    "ready/open": [
      "same",
      "other"
    ]
  },
  "rows": [
