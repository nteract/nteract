      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
      "forgotten",
      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
      "removed",
      "a released intent is deleted, so nothing resumes or answers it"
    ]
  ],
  "cases": {
    "reserved/closed": [
      "closed",
      "not-empty",
      "refused"
    ],
    "space_closed/trashed": [
      "trashed",
      "missing",
      "changed"
    ]
  },
  "rows": [
    {
      "label": "a new or resumed request closes the Space",
      "state": {
        "name": "reserved"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "reserved"
        },
        "effects": [
          {
            "type": "close_space"
          }
        ]
      }
    },
    {
      "label": "a resumed request trashes the content",
      "state": {
        "name": "space_closed"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "space_closed"
        },
        "effects": [
          {
            "type": "trash_content"
          }
        ]
      }
    },
    {
      "label": "a resumed request reopens the Space",
      "state": {
        "name": "reopening"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "reopening"
        },
        "effects": [
          {
            "type": "reopen_space"
          }
        ]
      }
    },
    {
      "label": "a resumed request purges the content",
      "state": {
        "name": "content_trashed"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "content_trashed"
        },
        "effects": [
          {
            "type": "purge_content"
          }
        ]
      }
    },
    {
      "label": "a resumed request removes the Catalog entries",
      "state": {
        "name": "content_deleted"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "content_deleted"
        },
        "effects": [
          {
            "type": "forget_catalog"
          }
        ]
      }
    },
    {
      "label": "a resumed request removes the Space record",
      "state": {
        "name": "catalog_forgotten"
      },
      "event": {
        "type": "resume"
      },
      "expect": {
        "state": {
          "name": "catalog_forgotten"
        },
        "effects": [
          {
            "type": "remove_space"
          }
        ]
      }
    },
    {
      "case": "closed",
      "label": "a valid token closes the Space; the Catalog hides the entry before it persists the phase",
      "state": {
        "name": "reserved"
      },
      "event": {
        "type": "closed",
        "ok": true
      },
      "expect": {
        "state": {
          "name": "space_closed"
        },
        "effects": [
          {
            "type": "hide_project"
          },
          {
            "type": "persist",
            "state": "space_closed"
          },
          {
            "type": "trash_content"
          }
        ]
      }
    },
    {
      "case": "not-empty",
      "label": "a Project that holds a Page is refused and its key released",
      "state": {
        "name": "reserved"
      },
      "event": {
        "type": "closed",
        "ok": false,
        "refusal": "not_empty"
      },
      "expect": {
        "state": {
          "name": "released"
        },
        "effects": [
          {
            "type": "release"
          }
        ],
        "response": {
          "status": 409,
          "body": {
            "error": "This Project still holds Pages. Move them out of the Project, or move them to Trash and delete them permanently, before deleting it.",
            "code": "project_not_empty"
          }
        }
      }
    },
    {
      "case": "refused",
      "label": "the Space or the content refused before anything changed; its answer passes through",
      "state": {
        "name": "reserved"
      },
      "event": {
        "type": "closed",
        "ok": false,
        "refusal": "space"
      },
      "expect": {
        "state": {
          "name": "released"
        },
        "effects": [
          {
            "type": "release"
          }
        ],
        "response": {
          "reply": "refusal"
        }
      }
    },
    {
      "case": "trashed",
      "state": {
        "name": "space_closed"
      },
      "event": {
        "type": "trashed",
        "outcome": "trashed"
      },
      "expect": {
        "state": {
          "name": "content_trashed"
        },
        "effects": [
          {
            "type": "persist",
            "state": "content_trashed"
          },
          {
            "type": "purge_content"
          }
        ]
      }
    },
    {
      "case": "missing",
      "label": "content already deleted by an earlier attempt goes straight to the Catalog",
      "state": {
        "name": "space_closed"
      },
      "event": {
        "type": "trashed",
        "outcome": "missing"
      },
      "expect": {
        "state": {
          "name": "content_deleted"
        },
        "effects": [
          {
            "type": "persist",
            "state": "content_deleted"
          },
          {
            "type": "forget_catalog"
          }
        ]
      }
    },
    {
      "case": "changed",
      "label": "content written after the preview reopens the Space",
      "state": {
        "name": "space_closed"
      },
      "event": {
        "type": "trashed",
        "outcome": "changed"
      },
      "expect": {
        "state": {
          "name": "reopening"
        },
        "effects": [
          {
            "type": "persist",
            "state": "reopening"
          },
          {
            "type": "reopen_space"
          }
        ]
      }
    },
    {
      "state": {
        "name": "reopening"
      },
      "event": {
        "type": "reopened"
      },
      "expect": {
        "state": {
          "name": "released"
        },
        "effects": [
          {
            "type": "show_project"
          },
          {
            "type": "release"
          }
        ],
        "response": {
          "status": 409,
          "body": {
            "error": "The Project's content or its comments changed after its preview; preview the deletion again",
            "code": "purge_preview_invalid"
          }
        }
      }
    },
    {
      "state": {
        "name": "content_trashed"
      },
      "event": {
        "type": "purged"
      },
      "expect": {
        "state": {
          "name": "content_deleted"
        },
        "effects": [
          {
            "type": "persist",
            "state": "content_deleted"
          },
          {
            "type": "forget_catalog"
          }
        ]
      }
    },
    {
      "state": {
        "name": "content_deleted"
      },
      "event": {
        "type": "forgotten"
      },
      "expect": {
        "state": {
          "name": "catalog_forgotten"
        },
        "effects": [
          {
            "type": "persist",
            "state": "catalog_forgotten"
          },
          {
            "type": "remove_space"
          }
        ]
      }
    },
    {
      "label": "the receipt is recorded only once the Space record is gone",
      "state": {
        "name": "catalog_forgotten"
      },
      "event": {
        "type": "removed"
      },
      "expect": {
        "state": {
          "name": "deleted"
        },
        "effects": [
          {
            "type": "persist",
            "state": "deleted"
          },
          {
            "type": "sync"
          }
        ],
        "response": {
          "reply": "receipt"
        }
      }
    }
  ]
}
