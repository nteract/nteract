{
  "machine": "space-deletion",
  "description": "One delete_project confirm, driven by the owner's Catalog across the Space, the content document and the Catalog's own entries. The state is the journal intent's persisted phase.",
  "states": [
    "reserved",
    "space_closed",
    "reopening",
    "content_trashed",
    "content_deleted",
    "catalog_forgotten",
    "deleted",
    "released"
  ],
  "events": [
    "resume",
    "closed",
    "trashed",
    "reopened",
    "purged",
    "forgotten",
    "removed"
  ],
  "unreachable": [
    [
      "reserved",
      "trashed",
      "only space_closed runs the effect that trashed answers"
    ],
    [
      "reserved",
      "reopened",
      "only reopening runs the effect that reopened answers"
    ],
    [
