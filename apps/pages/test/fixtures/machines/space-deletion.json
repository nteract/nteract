      "a completed deletion replays its receipt before the machine runs"
    ],
    [
      "released",
      "resume",
      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
      "closed",
      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
      "trashed",
      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
      "reopened",
      "a released intent is deleted, so nothing resumes or answers it"
    ],
    [
      "released",
