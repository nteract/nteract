{
  "machine": "viewer-catch-up",
  "description": "Whether one viewer PageSession's status line says Catching up after a socket is admitted. The host's frontier (durableHeads and durableCommentHeads from /api/saved, asked once per socket and answered by every receipt) ends catch-up when this replica holds it, comments included; a kept frontier is rechecked on every remote change and when the comments replica installs or fails to open. The label shows only on evidence 300 ms after admission and stops quietly 15 s after it. Runs against viewer/catch-up-machine.mjs in viewer/catch-up.test.mjs.",
  "states": [
    "detached",
    "opening",
    "settling",
    "catchingUp",
    "current",
    "timedOut"
  ],
  "events": [
    "admitted",
    "disconnected",
    "elapsed",
    "expired",
    "remote",
    "recheck",
    "answered"
  ],
  "unreachable": [],
  "cases": {
    "opening/elapsed": [
      "behind",
      "unproven",
      "stale"
    ],
    "opening/expired": [
      "limit",
      "stale"
    ],
    "settling/expired": [
      "limit",
      "stale"
    ],
    "catchingUp/expired": [
      "limit",
      "stale"
    ],
    "opening/remote": [
      "held",
      "unproven"
    ],
    "catchingUp/remote": [
      "held",
      "unproven"
    ],
    "opening/recheck": [
      "held",
      "unheld",
      "none"
    ],
    "catchingUp/recheck": [
      "held",
      "unheld",
      "none"
    ],
    "opening/answered": [
      "held",
      "behind",
      "stale"
    ],
    "settling/answered": [
      "held",
      "behind",
      "stale"
    ],
    "catchingUp/answered": [
      "held",
      "behind",
      "stale"
    ],
    "timedOut/answered": [
      "held",
      "behind",
      "stale"
    ]
  },
