{
  "name": "@nteract/pages",
  "private": true,
  "type": "module",
  "workspaces": [
    "upstream/packages/*"
  ],
  "scripts": {
    "setup": "node setup.mjs",
    "build:upstream": "tsc -p upstream/packages/automerge-repo",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test": "tsx --tsconfig tsconfig.json --test worker/*.test.mjs model/*.test.mjs viewer/*.test.mjs sync/*.test.mjs test/*.test.mjs scripts/*.test.mjs",
    "test:properties": "tsx --tsconfig tsconfig.json --test model/structural-roundtrip.test.mjs model/concurrent-edits.test.mjs viewer/wordgard-binding-parity.test.mjs",
    "test:contract": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:editor": "node scripts/wordgard-smoke.mjs",
    "smoke:tables": "node scripts/editable-table-smoke.mjs",
    "test:e2e:sharing": "node scripts/local-sharing-e2e.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-repo": "3.0.0-experimental.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@nteract/sift": "0.6.0",
    "@types/node": "22.20.0",
    "diff": "8.0.2",
    "dompurify": "3.4.17",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.17.0",
    "markdown-it": "14.3.3",
    "modern-screenshot": "4.7.0",
    "pele": "1.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rxjs": "^7.8.2",
    "typescript": "6.0.3",
    "use-sync-external-store": "1.6.0",
    "wordgard": "0.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.59.1",
    "@types/debug": "4.1.12",
    "esbuild": "0.28.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "tsx": "4.21.0",
    "vitest": "3.2.7",
    "wrangler": "4.151.1"
  }
}
