/**
 * Relations and permissions for Projects and their items, written so a host's
 * relationship service can adopt them directly. Each permission named like a
 * capability (read, comment, edit, share, administer, trash, restore, purge,
 * create_items, manage_members, move_within, move_out) is the capability that
 * worker/authz.mjs `decide()` returns before nteract's local overlays.
 *
 * nteract applies two overlays after this model, in order: the item's
 * lifecycle (Trash, deletion), then the credential's ceiling (a read-only
 * credential keeps only read). Neither is a relation, so neither appears here,
 * and no relationship can reopen a trashed item.
 *
 * Execute is not modeled. Pages have no execution; notebooks will add it as
 * edit intersected with compute the caller holds.
 */

/**
 * user is a person. Agents act on behalf of a person: they hold no grants of
 * their own, so they never appear as subjects. decide() carries the verified
 * actor chain for attribution, and the credential an agent holds can only
 * narrow the person's capabilities.
 */
definition user {}

/**
 * organization is the tenant a host supplies. Built-in mode has no tenants:
 * there, company view stands in for organization membership, proven by a
 * short-lived verified email-domain lease rather than a stored relationship.
 */
definition organization {
	/** admin manages the organization. A host writes admins as members too. */
	relation admin: user

	/** member is a person in the organization. */
	relation member: user
}

/** group is a team inside an organization. Hosts supply groups; built-in mode has none. */
definition group {
	/** member is a person in the team. */
	relation member: user
}

/**
 * project is the container. It holds items of a kind (page now; notebook,
 * dashboard and result reserved). Items inside a project have no owner of
 * their own: the project's roles reach them through the arrows on each item.
 */
definition project {
	/** org is the tenant, when the host supplies one. Immutable. */
	relation org: organization

	/** owner is the person who owns the project. */
	relation owner: user

	/** editor contributes to every item in the project. */
	relation editor: user | group#member | organization#member

	/** viewer reads every item in the project. organization#member is company view. */
	relation viewer: user | group#member | organization#member

	/** contribute is the proposal's project.contribute: owner + editor. */
	permission contribute = owner + editor

	/** read_items is the proposal's project.read_items: contribute + viewer. */
	permission read_items = contribute + viewer

	/** administer is ownership of the project itself. */
	permission administer = owner

	/** read opens the project: its title, description and listing. */
	permission read = read_items

	/** edit changes the project's own title and description. */
	permission edit = administer

	/** share grants project roles; manage_members is the same authority. */
	permission share = administer
	permission manage_members = administer

	/** create_items adds items to the project. */
	permission create_items = contribute

	/** trash and restore move the project's items to and from Trash. */
	permission trash = contribute
	permission restore = contribute

	/** purge permanently deletes an item from Trash. */
	permission purge = administer

	/** move_within reorders or reparents items inside the project. */
	permission move_within = contribute

	/** move_out takes an item out of the project. */
	permission move_out = administer
}

/**
 * page is an item. An item has either a `project` or an `owner`, never both:
 * a personal item has an owner, an item in a project inherits the project's
 * roles. A move rewrites that one relation atomically. notebook, dashboard and
 * result items follow the same pattern when they arrive.
 */
definition page {
	/** org is the tenant, when the host supplies one. Immutable. */
	relation org: organization

	/** project holds this item. Exclusive with owner. */
	relation project: project

	/** owner is the person who owns this personal item. Exclusive with project. */
	relation owner: user

	/** editor is a direct grant to write and comment. */
	relation editor: user | group#member | organization#member

	/** commenter is a direct grant to read and comment, never to write the Page. */
	relation commenter: user | group#member

	/** viewer is a direct grant to read. organization#member is company view. */
	relation viewer: user | group#member | organization#member

	/**
	 * removed records a revoked direct grant. It subtracts from this item's own
	 * viewer path, so a removed person loses company view of the item even
	 * while they remain a member of the organization. Project roles are revoked
	 * on the project.
	 */
	relation removed: user

	/** administer is the proposal's item.administer: owner + project.owner. */
	permission administer = owner + project->administer

	/** edit is the proposal's item.edit: administer + editor + project.contribute. */
	permission edit = administer + editor + project->contribute

	/**
	 * comment writes the item's comments document: every editor, and
	 * commenters. Editing the item itself stays with edit.
	 */
	permission comment = edit + commenter

	/** read is the proposal's item.read, with removed subtracted from the direct viewer path. */
	permission read = comment + (viewer - removed) + project->read_items

	/** share is the proposal's item.share: grant direct roles on this item. */
	permission share = administer

	/** trash and restore this item. */
	permission trash = administer + project->trash
	permission restore = administer + project->restore

	/** purge permanently deletes this item from Trash. */
	permission purge = administer

	/** create_items nests new items under this one. */
	permission create_items = administer + project->create_items

	/** move_within reorders or reparents this item inside its project. */
	permission move_within = administer + project->move_within

	/** move_out takes this item out of its project, or a personal item into one. */
	permission move_out = administer
}
