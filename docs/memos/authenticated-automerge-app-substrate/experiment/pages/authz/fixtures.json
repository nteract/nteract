{
  "description": "Relationship tuples plus nteract's lifecycle overlay, and the capabilities decide() returns for each principal. Tuples use SpiceDB's resource#relation@subject syntax against schema.zed. modes lists who can produce the case: built-in (today's Page and Space records) or external (a host's relationship service; groups, organizations and project roles beyond owner exist only there). Organization and group membership tuples are leases on the principal: they expire at now + membership_lease_ms. Credentials expire at now + credential_ms; a read credential keeps only read. worker/authz.test.mjs runs every case through decide(), and checks the same tuples against SpiceDB with zed when zed is installed.",
  "now": 1000000,
  "credential_ms": 7200000,
  "membership_lease_ms": 3600000,
  "cases": [
    {
      "name": "owner of a personal Page",
      "modes": ["built-in", "external"],
      "object": "page:personal",
      "lifecycle": "active",
      "revision": 0,
      "relationships": ["page:personal#owner@user:alice"],
      "principals": [
        {
          "subject": "user:alice",
          "credential": "write",
          "capabilities": [
            "read",
            "comment",
            "edit",
            "share",
            "administer",
            "trash",
            "restore",
            "purge",
            "create_items",
            "move_within",
            "move_out"
          ],
          "basis": { "relation": "owner", "via": "direct" },
          "valid_until": 8200000
        },
        {
          "subject": "user:alice",
          "credential": "read",
          "capabilities": ["read"],
          "basis": { "relation": "owner", "via": "direct" }
        },
        { "subject": "user:mallory", "credential": "write", "capabilities": [] }
      ]
    },
    {
