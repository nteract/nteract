{
  "machine": "listing",
  "description": "One paged list_pages or list_projects listing behind the Pages library (/ and /pages) and /projects. `params` is the normalized request ({ query, access, sort, projectId }); the machine never looks inside it. The rows live beside it in viewer/listing.mjs. viewer/listing.test.mjs runs each row through the pure machine.",
  "states": [
    "idle",
    "loading",
    "ready",
    "more",
    "failed",
    "stalled"
  ],
  "events": [
    "load",
    "more",
    "loaded",
    "failed"
  ],
  "unreachable": [
    [
      "idle",
      "loaded",
      "Nothing is requested before the first load"
    ],
    [
      "idle",
      "failed",
      "Nothing is requested before the first load"
    ]
  ],
  "cases": {
    "loading/loaded": [
      "current",
      "stale"
    ],
    "loading/failed": [
      "current",
      "stale"
    ],
    "more/loaded": [
      "current",
      "stale"
    ],
    "more/failed": [
      "current",
      "stale",
      "expired"
    ],
    "ready/more": [
      "cursor",
      "end"
    ]
  },
