{
  "machine": "viewer-sync-status",
  "description": "What one viewer PageSession's status line says about receipts and the native connection. Remote changes sync; only local edits save. Runs against viewer/sync-status-machine.mjs in viewer/sync-status-machine.test.mjs.",
  "states": [
    "idle",
    "syncing",
    "saving",
    "saved",
    "local",
    "unsaved"
  ],
  "events": [
    "opened",
    "queued",
    "acknowledged",
    "stalled",
    "admitted",
    "retrying",
    "unreachable"
  ],
  "unreachable": [
    [
      "syncing",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "saving",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "saved",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "local",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "unsaved",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ]
  ],
  "cases": {
    "idle/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "local/acknowledged": [
      "current",
      "stale"
    ],
    "local/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "local/stalled": [
