  "rows": [
    {
      "label": "a clean checkpoint opens with nothing pending",
      "state": {
        "name": "idle",
        "revision": 0,
        "pending": false,
        "link": "connecting"
      },
      "event": {
        "type": "opened",
        "pending": false
      },
      "expect": {
        "state": {
          "name": "idle",
          "revision": 0,
          "pending": false,
          "link": "connecting"
        },
        "effects": []
      }
    },
    {
