{
  "machine": "viewer-sync-status",
  "description": "What one viewer PageSession's status line says about receipts and the native connection. Remote changes sync; only local edits save. A save stays quiet for its first 2 s and shows Saving only after that, or at once after a failed receipt. Runs against viewer/sync-status-machine.mjs in viewer/sync-status-machine.test.mjs.",
  "states": [
    "idle",
    "syncing",
    "quiet",
    "saving",
    "saved",
    "local",
    "unsaved"
  ],
  "events": [
    "opened",
    "queued",
    "acknowledged",
    "stalled",
    "elapsed",
    "admitted",
    "retrying",
    "unreachable"
  ],
  "unreachable": [
    [
      "syncing",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "quiet",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "saving",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "saved",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "local",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ],
    [
      "unsaved",
      "opened",
      "start() installs the replica once, before it queues any receipt"
    ]
  ],
  "cases": {
    "idle/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "local/acknowledged": [
      "current",
      "stale"
    ],
    "local/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "local/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ],
    "quiet/acknowledged": [
      "current",
      "stale"
    ],
    "quiet/elapsed": [
      "current",
      "stale"
    ],
    "quiet/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "quiet/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ],
    "saved/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "saved/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ],
    "saving/acknowledged": [
      "current",
      "stale"
    ],
    "saving/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "saving/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ],
    "syncing/acknowledged": [
      "current",
      "stale"
    ],
    "syncing/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "syncing/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ],
    "unsaved/acknowledged": [
      "current",
      "stale"
    ],
    "unsaved/queued": [
      "remote",
      "edit",
      "stale"
    ],
    "unsaved/stalled": [
      "local-copy",
      "no-copy",
      "stale"
    ]
