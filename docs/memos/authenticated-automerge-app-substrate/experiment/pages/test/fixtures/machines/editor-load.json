{
  "machine": "editor-load",
  "description": "The viewer's one dynamic import of the Page editor chunk (and the WASM runtimes behind it). It starts at boot on Page routes and on first use from the index routes. A failed import stays failed until the tab reloads. Runs against viewer/editor-load-machine.mjs in viewer/editor-loader.test.mjs.",
  "states": [
    "idle",
    "loading",
    "ready",
    "failed"
  ],
  "events": [
    "start",
    "loaded",
    "failed"
  ],
  "unreachable": [
    [
      "idle",
      "loaded",
      "The import runs only after start"
    ],
    [
      "idle",
      "failed",
      "The import runs only after start"
    ]
  ],
  "rows": [
    {
      "label": "the first start imports the editor",
      "note": "Boot on a Page route, or the first Page open or creation from an index route.",
      "state": {
        "name": "idle"
      },
      "event": {
        "type": "start"
      },
      "expect": {
        "state": {
          "name": "loading"
        },
        "effects": [
          {
            "type": "import"
          }
        ]
      }
    },
    {
      "label": "a start during the import waits for it",
      "state": {
        "name": "loading"
      },
      "event": {
        "type": "start"
      },
      "expect": {
        "state": {
          "name": "loading"
        },
        "effects": [],
        "rejected": "The editor import is already running"
      }
    },
    {
      "label": "the import resolves: Pages can open",
      "state": {
        "name": "loading"
      },
      "event": {
        "type": "loaded"
      },
      "expect": {
        "state": {
          "name": "ready"
        },
        "effects": []
      }
    },
    {
      "label": "the import rejects: ask the server for its build",
      "note": "A deploy that retired this tab's chunks shows the reload banner as a server change.",
      "state": {
        "name": "loading"
      },
      "event": {
        "type": "failed",
        "message": "Failed to fetch dynamically imported module"
      },
      "expect": {
        "state": {
          "name": "failed",
          "message": "Failed to fetch dynamically imported module"
        },
        "effects": [
          {
            "type": "checkBuild"
          }
        ]
      }
    },
    {
      "label": "a loaded editor stays loaded",
      "state": {
        "name": "ready"
      },
      "event": {
        "type": "loaded"
      },
      "expect": {
        "state": {
          "name": "ready"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    },
    {
      "label": "a loaded editor ignores a late failure",
      "state": {
        "name": "ready"
      },
      "event": {
        "type": "failed",
        "message": "late"
      },
      "expect": {
        "state": {
          "name": "ready"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    },
    {
      "label": "a failed import never becomes ready without a reload",
      "state": {
        "name": "failed",
        "message": "404"
      },
      "event": {
        "type": "loaded"
      },
      "expect": {
        "state": {
          "name": "failed",
          "message": "404"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    },
    {
      "label": "a second failure keeps the first reason and checks the build once",
      "state": {
        "name": "failed",
        "message": "404"
      },
      "event": {
        "type": "failed",
        "message": "again"
      },
      "expect": {
        "state": {
          "name": "failed",
          "message": "404"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    },
    {
      "label": "a loaded editor needs no second import",
      "state": {
        "name": "ready"
      },
      "event": {
        "type": "start"
      },
      "expect": {
        "state": {
          "name": "ready"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    },
    {
      "label": "a failed import is not retried without a reload",
      "state": {
        "name": "failed",
        "message": "404"
      },
      "event": {
        "type": "start"
      },
      "expect": {
        "state": {
          "name": "failed",
          "message": "404"
        },
        "effects": [],
        "rejected": "The editor import already settled"
      }
    }
  ]
}
