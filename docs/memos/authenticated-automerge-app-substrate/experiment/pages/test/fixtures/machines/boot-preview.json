{
  "machine": "boot-preview",
  "description": "The read-only preview a Page route may show while the editor loads, for one page load and only to the account the host authenticated for the answer. Runs against viewer/boot-preview-machine.mjs in viewer/boot-preview.test.mjs.",
  "states": [
    "idle",
    "pending",
    "shown",
    "retired"
  ],
  "events": [
    "start",
    "session",
    "resolved",
    "refused",
    "navigated",
    "installed",
    "invalidated"
  ],
  "unreachable": [
    [
      "idle",
      "resolved",
      "The early answer is read only after start"
    ],
    [
      "idle",
      "invalidated",
      "Only a started preview watches the early request"
    ],
    [
      "shown",
      "resolved",
      "The early answer resolves once, and shown already holds it"
    ]
  ],
  "cases": {
    "pending/session": [
      "signed-out",
      "changed",
      "shows",
      "mismatch",
      "records",
      "unchanged"
    ],
    "pending/resolved": [
      "wrong-page",
      "duplicate",
      "shows",
      "mismatch",
      "records"
    ],
    "pending/navigated": [
      "same-page",
      "other-route"
    ],
    "shown/session": [
      "unchanged",
      "signed-out",
      "changed"
    ],
    "shown/navigated": [
      "same-page",
      "other-route"
    ]
  },
  "rows": [
