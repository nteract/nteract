        "name": "ready",
        "attempts": 5,
        "refusals": 2
      },
      "event": {
        "type": "failed",
        "refused": false
      },
      "expect": {
        "state": {
          "name": "waiting",
          "attempts": 6,
          "refusals": 2
        },
        "effects": [
          {
            "type": "schedule",
            "step": 16000
          }
        ]
      }
    },
    {
      "label": "the seventh failure in a row reports an outage and keeps retrying",
      "case": "outage",
      "state": {
        "name": "ready",
        "attempts": 6,
        "refusals": 0
      },
      "event": {
        "type": "failed",
        "refused": false
      },
      "expect": {
        "state": {
          "name": "waiting",
          "attempts": 7,
          "refusals": 0
        },
        "effects": [
          {
            "type": "schedule",
            "step": 32000
          },
          {
            "type": "reportOutage"
          }
        ]
      }
    },
    {
      "label": "the step reaches its 60 s cap",
