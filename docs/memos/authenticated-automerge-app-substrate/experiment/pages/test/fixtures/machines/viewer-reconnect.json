{
  "machine": "viewer-reconnect",
  "description": "Automatic reconnects for one viewer PageSession: a 10 s deadline on each socket's authenticated handshake, exponential backoff with a 60 s cap for transient failures, a stop on a refused signing key, a pause after six admission refusals in a row, and an outage report from the seventh transient failure in a row while retries continue. Runs against viewer/reconnect-machine.mjs in viewer/reconnect-machine.test.mjs.",
  "states": [
    "ready",
    "handshaking",
    "waiting",
    "refused",
    "paused"
  ],
  "events": [
    "handshake",
    "admitted",
    "handshakeEnded",
    "handshakeTimeout",
    "failed",
    "keyRefused",
    "stable",
    "timer",
    "resume",
    "halt"
  ],
  "unreachable": [],
  "cases": {
    "ready/failed": [
      "transient",
      "outage",
      "refusal",
      "last-refusal"
    ],
    "handshaking/failed": [
      "transient",
      "outage",
      "refusal",
      "last-refusal"
    ],
    "handshaking/handshakeTimeout": [
      "transient",
      "outage"
    ]
  },
  "rows": [
    {
      "label": "the first retry waits about half a second",
      "case": "transient",
      "state": {
        "name": "ready",
        "attempts": 0,
        "refusals": 0
      },
      "event": {
        "type": "failed",
        "refused": false
      },
      "expect": {
        "state": {
          "name": "waiting",
          "attempts": 1,
          "refusals": 0
        },
        "effects": [
          {
            "type": "schedule",
            "step": 500
          }
        ]
      }
    },
    {
      "label": "the step doubles past the old 10 s ceiling",
