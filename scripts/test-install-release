make_darwin_fixtures "$WORK/headless-assets" "$HEADLESS_LOG"
PATH="$WORK/shim-darwin:$PATH" run_installer "$HEADLESS_HOME" \
  --from-dir "$WORK/headless-assets" --cli > "$WORK/headless-out.log"
