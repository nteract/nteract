#!/usr/bin/env bash
# Fixture tests for scripts/install-linux-release.
#
# Runs the real installer against --from-dir fixtures with HOME pointed at a
# sandbox. Darwin code paths run on any host through a PATH-shimmed `uname`,
# so CI on Linux still covers the macOS bundle install, link layout, and
# headless variant.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER="$SCRIPT_DIR/install-linux-release"

WORK="$(mktemp -d)"
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

FAILURES=0
note() { printf '\n=== %s ===\n' "$1"; }
fail() {
  echo "FAIL: $1" >&2
  FAILURES=$((FAILURES + 1))
}
assert_link() {
  local link="$1"
  local target="$2"
  if [[ "$(readlink "$link" 2>/dev/null)" != "$target" ]]; then
    fail "$link should link to $target (got: $(readlink "$link" 2>/dev/null || echo '<missing>'))"
  fi
}
assert_file() {
  [[ -e "$1" ]] || fail "expected $1 to exist"
}
assert_missing() {
  [[ ! -e "$1" ]] || fail "expected $1 to be absent"
}

make_fake_tool() {
  # A recording binary: appends its argv to calls.log next to the fixture
  # root so tests can assert the daemon doctor/status invocations.
  local path="$1"
  local log="$2"
  mkdir -p "$(dirname "$path")"
  cat > "$path" <<EOF
#!/usr/bin/env bash
echo "\$(basename "\$0") \$*" >> "$log"
exit 0
EOF
  chmod 0755 "$path"
}

make_linux_fixtures() {
  local dir="$1"
  local log="$2"
  local arch="${3:-x64}"
  mkdir -p "$dir"
  make_fake_tool "$dir/runt-linux-$arch" "$log"
  make_fake_tool "$dir/nteract-cli-linux-$arch" "$log"
  make_fake_tool "$dir/runtimed-linux-$arch" "$log"
  make_fake_tool "$dir/nteract-mcp-linux-$arch" "$log"
  echo "fake $arch appimage" > "$dir/nteract-stable-linux-$arch.AppImage"
}

make_nightly_linux_fixtures() {
  local dir="$1"
  local log="$2"
  mkdir -p "$dir"
  make_fake_tool "$dir/runt-nightly-linux-x64" "$log"
  make_fake_tool "$dir/nteract-cli-nightly-linux-x64" "$log"
  make_fake_tool "$dir/runtimed-nightly-linux-x64" "$log"
  make_fake_tool "$dir/nteract-mcp-nightly-linux-x64" "$log"
  echo "fake nightly appimage" > "$dir/nteract-nightly-linux-x64.AppImage"
}

make_darwin_fixtures() {
  local dir="$1"
  local log="$2"
  local stage="$dir/.stage"
  local recorders="$dir/.recorders"
  mkdir -p "$dir" "$recorders" "$stage/nteract.app/Contents/MacOS"
  for tool in nteract nteract-cli runt runtimed nteract-mcp; do
    # macOS kills shell scripts whose executed path is inside
    # *.app/Contents/MacOS. Keep the recorder script outside the bundle and
    # put an executable symlink where the app sidecar would be.
    make_fake_tool "$recorders/$tool" "$log"
    ln -s "$recorders/$tool" "$stage/nteract.app/Contents/MacOS/$tool"
  done
  tar -czf "$dir/nteract-stable-darwin-arm64.app.tar.gz" -C "$stage" "nteract.app"
  rm -rf "$stage"
}

make_uname_shim() {
  # The installer consults plain `uname`, so a PATH shim is enough to walk
  # the Darwin branches on a Linux host.
  local dir="$1"
  local kernel="$2"
  local machine="$3"
  mkdir -p "$dir"
  cat > "$dir/uname" <<EOF
#!/usr/bin/env bash
case "\${1:-}" in
  -s) echo "$kernel" ;;
  -m) echo "$machine" ;;
  *) echo "$kernel" ;;
esac
EOF
  chmod 0755 "$dir/uname"
}

make_fetch_tool_path_without_curl() {
  local dir="$1"
  local assets="$2"
  local log="$3"
  mkdir -p "$dir"

  local tool
  for tool in bash basename chmod cp dirname env ln mkdir mktemp mv readlink rm; do
    ln -s "$(command -v "$tool")" "$dir/$tool"
  done

  cat > "$dir/wget" <<EOF
#!/usr/bin/env bash
set -euo pipefail
out=""
url=""
while [[ \$# -gt 0 ]]; do
  case "\$1" in
    -O)
      out="\${2:-}"
      shift 2
      ;;
    *)
      url="\$1"
      shift
      ;;
  esac
done
if [[ -z "\$out" || -z "\$url" ]]; then
  echo "wget shim expected -O <dest> <url>" >&2
  exit 2
fi
asset="\${url##*/}"
echo "wget \$asset -> \$out" >> "$log"
# GNU wget prints the status line and exits 8 on an HTTP error such as 404.
if [[ ! -f "$assets/\$asset" ]]; then
  echo "  HTTP/1.1 404 Not Found" >&2
  exit 8
fi
cp "$assets/\$asset" "\$out"
EOF
  chmod 0755 "$dir/wget"
}

run_installer() {
  local home="$1"
  shift
  mkdir -p "$home"
  HOME="$home" XDG_DATA_HOME="" bash "${INSTALLER_UNDER_TEST:-$INSTALLER}" "$@"
}

note "linux desktop install"
LINUX_HOME="$WORK/linux-home"
LINUX_LOG="$WORK/linux-calls.log"
make_linux_fixtures "$WORK/linux-assets" "$LINUX_LOG"
make_uname_shim "$WORK/shim-linux" "Linux" "x86_64"
PATH="$WORK/shim-linux:$PATH" run_installer "$LINUX_HOME" \
  --from-dir "$WORK/linux-assets" --no-start > "$WORK/linux-out.log"
PREFIX="$LINUX_HOME/.local/share/nteract/stable"
assert_file "$PREFIX/nteract.AppImage"
assert_link "$LINUX_HOME/.local/bin/runt" "$PREFIX/bin/runt"
assert_link "$LINUX_HOME/.local/bin/runtimed" "$PREFIX/bin/runtimed"
assert_link "$LINUX_HOME/.local/bin/nteract-mcp" "$PREFIX/bin/nteract-mcp"
assert_link "$LINUX_HOME/.local/bin/nteract" "$PREFIX/bin/nteract-cli"
assert_link "$LINUX_HOME/.local/bin/nteract-desktop" "$PREFIX/nteract.AppImage"
grep -q "runt daemon doctor --fix --no-start" "$LINUX_LOG" || fail "linux: daemon doctor --fix --no-start not invoked"

note "linux arm64 desktop install selects arm64 assets"
for machine in aarch64 arm64; do
  ARM_HOME="$WORK/linux-arm64-$machine-home"
  ARM_LOG="$WORK/linux-arm64-$machine-calls.log"
  make_linux_fixtures "$WORK/linux-arm64-assets-$machine" "$ARM_LOG" arm64
  make_uname_shim "$WORK/shim-linux-arm64-$machine" "Linux" "$machine"
  PATH="$WORK/shim-linux-arm64-$machine:$PATH" run_installer "$ARM_HOME" \
    --from-dir "$WORK/linux-arm64-assets-$machine" --no-start > "$WORK/linux-arm64-$machine-out.log"
  ARM_PREFIX="$ARM_HOME/.local/share/nteract/stable"
  grep -qx "fake arm64 appimage" "$ARM_PREFIX/nteract.AppImage" || fail "linux $machine: arm64 AppImage not installed"
  assert_link "$ARM_HOME/.local/bin/runt" "$ARM_PREFIX/bin/runt"
  assert_link "$ARM_HOME/.local/bin/runtimed" "$ARM_PREFIX/bin/runtimed"
  assert_link "$ARM_HOME/.local/bin/nteract-mcp" "$ARM_PREFIX/bin/nteract-mcp"
  assert_link "$ARM_HOME/.local/bin/nteract" "$ARM_PREFIX/bin/nteract-cli"
  grep -q "linux-arm64-assets-$machine/runt-linux-arm64" "$WORK/linux-arm64-$machine-out.log" || fail "linux $machine: runt-linux-arm64 not used"
  grep -q "runt daemon doctor --fix --no-start" "$ARM_LOG" || fail "linux $machine: daemon doctor --fix --no-start not invoked"
done

note "linux download install falls back to wget without curl"
WGET_HOME="$WORK/wget-home"
WGET_LOG="$WORK/wget-calls.log"
WGET_DOWNLOAD_LOG="$WORK/wget-downloads.log"
make_linux_fixtures "$WORK/wget-assets" "$WGET_LOG"
make_fetch_tool_path_without_curl "$WORK/no-curl-tools" "$WORK/wget-assets" "$WGET_DOWNLOAD_LOG"
PATH="$WORK/shim-linux:$WORK/no-curl-tools" run_installer "$WGET_HOME" \
  --tag v9.9.9-stable.202601010101 --no-start > "$WORK/wget-out.log" 2>&1
WGET_PREFIX="$WGET_HOME/.local/share/nteract/stable"
assert_file "$WGET_PREFIX/nteract.AppImage"
assert_link "$WGET_HOME/.local/bin/runt" "$WGET_PREFIX/bin/runt"
grep -q "wget runt-linux-x64" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: runt asset was not downloaded with wget"
grep -q "wget nteract-cli-linux-x64" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: canonical CLI asset was not downloaded"
grep -q "wget runtimed-linux-x64" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: runtimed asset was not downloaded with wget"
grep -q "wget nteract-mcp-linux-x64" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: mcp asset was not downloaded with wget"
grep -q "wget nteract-stable-linux-x64.AppImage" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: appimage asset was not downloaded with wget"
grep -q "runt daemon doctor --fix --no-start" "$WGET_LOG" || fail "wget fallback: daemon doctor --fix --no-start not invoked"
grep -q "wget SHA256SUMS" "$WGET_DOWNLOAD_LOG" || fail "wget fallback: SHA256SUMS was not requested"
grep -q "this release has no SHA256SUMS" "$WORK/wget-out.log" || fail "wget fallback: missing SHA256SUMS should warn"

note "linux nightly desktop install"
NIGHTLY_HOME="$WORK/nightly-home"
NIGHTLY_LOG="$WORK/nightly-calls.log"
make_nightly_linux_fixtures "$WORK/nightly-assets" "$NIGHTLY_LOG"
STAMPED_NIGHTLY_INSTALLER="$WORK/install-linux-release-nightly"
sed \
  -e 's/^DEFAULT_CHANNEL="stable"$/DEFAULT_CHANNEL="nightly"/' \
  -e 's/^DEFAULT_TAG=""$/DEFAULT_TAG="v9.9.9-nightly.202601010101"/' \
  "$INSTALLER" > "$STAMPED_NIGHTLY_INSTALLER"
chmod 0755 "$STAMPED_NIGHTLY_INSTALLER"
INSTALLER_UNDER_TEST="$STAMPED_NIGHTLY_INSTALLER" PATH="$WORK/shim-linux:$PATH" \
  run_installer "$NIGHTLY_HOME" --from-dir "$WORK/nightly-assets" --no-start > "$WORK/nightly-out.log"
NIGHTLY_PREFIX="$NIGHTLY_HOME/.local/share/nteract/nightly"
assert_file "$NIGHTLY_PREFIX/nteract-nightly.AppImage"
assert_link "$NIGHTLY_HOME/.local/bin/runt-nightly" "$NIGHTLY_PREFIX/bin/runt-nightly"
assert_link "$NIGHTLY_HOME/.local/bin/runtimed-nightly" "$NIGHTLY_PREFIX/bin/runtimed-nightly"
assert_link "$NIGHTLY_HOME/.local/bin/nteract-mcp-nightly" "$NIGHTLY_PREFIX/bin/nteract-mcp-nightly"
assert_link "$NIGHTLY_HOME/.local/bin/nteract" "$NIGHTLY_PREFIX/bin/nteract-cli"
assert_link "$NIGHTLY_HOME/.local/bin/nteract-desktop-nightly" "$NIGHTLY_PREFIX/nteract-nightly.AppImage"
grep -q "runt-nightly daemon doctor --fix --no-start" "$NIGHTLY_LOG" || fail "nightly: daemon doctor --fix --no-start not invoked"

note "linux nightly headless install"
NIGHTLY_HEADLESS_HOME="$WORK/nightly-headless-home"
NIGHTLY_HEADLESS_LOG="$WORK/nightly-headless-calls.log"
make_nightly_linux_fixtures "$WORK/nightly-headless-assets" "$NIGHTLY_HEADLESS_LOG"
INSTALLER_UNDER_TEST="$STAMPED_NIGHTLY_INSTALLER" PATH="$WORK/shim-linux:$PATH" \
  run_installer "$NIGHTLY_HEADLESS_HOME" --from-dir "$WORK/nightly-headless-assets" \
  --headless --no-start > "$WORK/nightly-headless-out.log"
NIGHTLY_HEADLESS_PREFIX="$NIGHTLY_HEADLESS_HOME/.local/share/nteract/nightly"
assert_missing "$NIGHTLY_HEADLESS_PREFIX/nteract-nightly.AppImage"
assert_link "$NIGHTLY_HEADLESS_HOME/.local/bin/runt-nightly" "$NIGHTLY_HEADLESS_PREFIX/bin/runt-nightly"
assert_link "$NIGHTLY_HEADLESS_HOME/.local/bin/runtimed-nightly" "$NIGHTLY_HEADLESS_PREFIX/bin/runtimed-nightly"
assert_link "$NIGHTLY_HEADLESS_HOME/.local/bin/nteract-mcp-nightly" "$NIGHTLY_HEADLESS_PREFIX/bin/nteract-mcp-nightly"
assert_missing "$NIGHTLY_HEADLESS_LOG"
assert_link "$NIGHTLY_HEADLESS_HOME/.local/bin/nteract" "$NIGHTLY_HEADLESS_PREFIX/bin/nteract-cli"
grep -q "$NIGHTLY_HEADLESS_HOME/.local/bin/nteract\" --channel nightly workstation connect" "$WORK/nightly-headless-out.log" || fail "nightly headless: summary should name the installed CLI"
grep -q "$NIGHTLY_HEADLESS_HOME/.local/bin/nteract\" --channel nightly workstation service install --start" "$WORK/nightly-headless-out.log" || fail "nightly headless: summary should name the installed service command"
grep -q "$NIGHTLY_HEADLESS_HOME/.local/bin/nteract\" --channel nightly workstation run" "$WORK/nightly-headless-out.log" || fail "nightly headless: summary should name the installed run command"

note "darwin desktop install (explicit --applications-dir)"
DARWIN_HOME="$WORK/darwin-home"
DARWIN_LOG="$WORK/darwin-calls.log"
make_darwin_fixtures "$WORK/darwin-assets" "$DARWIN_LOG"
make_uname_shim "$WORK/shim-darwin" "Darwin" "arm64"
APPS_DIR="$WORK/fake-applications"
APP_DEST="$APPS_DIR/nteract.app"
PATH="$WORK/shim-darwin:$PATH" run_installer "$DARWIN_HOME" \
  --from-dir "$WORK/darwin-assets" --applications-dir "$APPS_DIR" --no-start \
  > "$WORK/darwin-out.log" 2>&1
assert_file "$APP_DEST/Contents/MacOS/runt"
assert_link "$DARWIN_HOME/.local/bin/runt" "$APP_DEST/Contents/MacOS/runt"
assert_link "$DARWIN_HOME/.local/bin/runtimed" "$APP_DEST/Contents/MacOS/runtimed"
assert_link "$DARWIN_HOME/.local/bin/nteract-mcp" "$APP_DEST/Contents/MacOS/nteract-mcp"
assert_link "$DARWIN_HOME/.local/bin/nteract" "$APP_DEST/Contents/MacOS/nteract-cli"
assert_missing "$DARWIN_HOME/.local/share/nteract/stable/nteract.app"
grep -q "runt daemon doctor --fix --no-start" "$DARWIN_LOG" || fail "darwin: daemon doctor --fix --no-start not invoked"
grep -q "App:      $APP_DEST" "$WORK/darwin-out.log" || fail "darwin: summary should name the installed app"
grep -q "not writable" "$WORK/darwin-out.log" && fail "darwin explicit: no fallback note expected"

note "darwin desktop default installs to ~/Applications (per-user by design)"
DEFAULT_HOME="$WORK/default-home"
DEFAULT_APP="$DEFAULT_HOME/Applications/nteract.app"
PATH="$WORK/shim-darwin:$PATH" run_installer "$DEFAULT_HOME" \
  --from-dir "$WORK/darwin-assets" --no-start > "$WORK/default-out.log" 2>&1
assert_file "$DEFAULT_APP/Contents/MacOS/runt"
assert_link "$DEFAULT_HOME/.local/bin/runt" "$DEFAULT_APP/Contents/MacOS/runt"
grep -q "App:      $DEFAULT_APP" "$WORK/default-out.log" || fail "darwin default: summary should name ~/Applications app"

note "darwin desktop reinstall replaces the bundle"
PATH="$WORK/shim-darwin:$PATH" run_installer "$DARWIN_HOME" \
  --from-dir "$WORK/darwin-assets" --applications-dir "$APPS_DIR" --no-start \
  > "$WORK/darwin-out2.log"
assert_file "$APP_DEST/Contents/MacOS/runt"
assert_missing "$APP_DEST.new"

note "darwin headless install"
HEADLESS_HOME="$WORK/headless-home"
HEADLESS_LOG="$WORK/headless-calls.log"
make_darwin_fixtures "$WORK/headless-assets" "$HEADLESS_LOG"
PATH="$WORK/shim-darwin:$PATH" run_installer "$HEADLESS_HOME" \
  --from-dir "$WORK/headless-assets" --cli > "$WORK/headless-out.log"
HEADLESS_APP="$HEADLESS_HOME/.local/share/nteract/stable/nteract.app"
assert_file "$HEADLESS_APP/Contents/MacOS/runtimed"
assert_missing "$HEADLESS_HOME/Applications"
assert_link "$HEADLESS_HOME/.local/bin/runt" "$HEADLESS_APP/Contents/MacOS/runt"
assert_missing "$HEADLESS_LOG"
assert_link "$HEADLESS_HOME/.local/bin/nteract" "$HEADLESS_APP/Contents/MacOS/nteract-cli"
grep -q "$HEADLESS_HOME/.local/bin/nteract\" --channel stable workstation connect" "$WORK/headless-out.log" || fail "headless: summary should mention the installed workstation pairing flow"
grep -q "$HEADLESS_HOME/.local/bin/nteract\" --channel stable workstation run" "$WORK/headless-out.log" || fail "headless: summary should mention the installed foreground workstation flow"
grep -q "Persistent workstation service management starts with Linux user systemd" "$WORK/headless-out.log" || fail "headless: summary should explain service platform support"
grep -q "workstation service install --start" "$WORK/headless-out.log" && fail "darwin headless: summary should not print the Linux-only service command"

note "channel installs retain selection until explicitly changed"
for first_channel in stable nightly; do
  COEXIST_HOME="$WORK/coexist-$first_channel"
  for channel in "$first_channel" stable nightly; do
    assets="$WORK/linux-assets"
    [[ "$channel" != nightly ]] || assets="$WORK/nightly-assets"
    PATH="$WORK/shim-linux:$PATH" run_installer "$COEXIST_HOME" \
      --channel "$channel" --from-dir "$assets" --cli > "$WORK/coexist-out.log"
    assert_link "$COEXIST_HOME/.local/bin/nteract" "$COEXIST_HOME/.local/share/nteract/$first_channel/bin/nteract-cli"
  done
  PATH="$WORK/shim-linux:$PATH" run_installer "$COEXIST_HOME" \
    --channel nightly --from-dir "$WORK/nightly-assets" --cli --default-cli > "$WORK/coexist-out.log"
  assert_link "$COEXIST_HOME/.local/bin/nteract" "$COEXIST_HOME/.local/share/nteract/nightly/bin/nteract-cli"
  grep -qx "$COEXIST_HOME/.local/share/nteract/stable/bin/nteract-cli" "$COEXIST_HOME/.local/bin/.nteract-cli-stable-target" || fail "stable record missing"
  grep -qx "$COEXIST_HOME/.local/share/nteract/nightly/bin/nteract-cli" "$COEXIST_HOME/.local/bin/.nteract-cli-nightly-target" || fail "nightly record missing"
done

note "selected installation can move to a custom prefix without changing channel"
CUSTOM_HOME="$WORK/custom-home"
CUSTOM_BIN="$WORK/custom commands"
for prefix in "$WORK/first prefix" "$WORK/replacement prefix"; do
  PATH="$WORK/shim-linux:$PATH" run_installer "$CUSTOM_HOME" \
    --from-dir "$WORK/linux-assets" --cli --bin-dir "$CUSTOM_BIN" --prefix "$prefix" > "$WORK/custom-out.log"
  assert_link "$CUSTOM_BIN/nteract" "$prefix/bin/nteract-cli"
  assert_link "$CUSTOM_BIN/runt" "$prefix/bin/runt"
  assert_link "$CUSTOM_BIN/runtimed" "$prefix/bin/runtimed"
  assert_link "$CUSTOM_BIN/nteract-mcp" "$prefix/bin/nteract-mcp"
done

note "legacy stable AppImage alias migrates while existing nightly alias remains"
LEGACY_HOME="$WORK/legacy-home"
LEGACY_PREFIX="$LEGACY_HOME/.local/share/nteract/stable"
mkdir -p "$LEGACY_HOME/.local/bin" "$LEGACY_PREFIX"
echo "existing app" > "$LEGACY_PREFIX/nteract.AppImage"
ln -s "$LEGACY_PREFIX/nteract.AppImage" "$LEGACY_HOME/.local/bin/nteract"
ln -s "$LEGACY_HOME/.local/share/nteract/nightly/nteract-nightly.AppImage" "$LEGACY_HOME/.local/bin/nteract-nightly"
PATH="$WORK/shim-linux:$PATH" run_installer "$LEGACY_HOME" \
  --from-dir "$WORK/linux-assets" --cli > "$WORK/legacy-out.log"
assert_link "$LEGACY_HOME/.local/bin/nteract" "$LEGACY_PREFIX/bin/nteract-cli"
assert_link "$LEGACY_HOME/.local/bin/nteract-desktop" "$LEGACY_PREFIX/nteract.AppImage"
grep -Fq "Launcher: $LEGACY_HOME/.local/bin/nteract-desktop" "$WORK/legacy-out.log" || fail "CLI migration should report the preserved desktop launcher"
grep -qx "existing app" "$LEGACY_PREFIX/nteract.AppImage" || fail "headless migration changed desktop app"
PATH="$WORK/shim-linux:$PATH" run_installer "$LEGACY_HOME" \
  --channel nightly --from-dir "$WORK/nightly-assets" --cli > "$WORK/legacy-out.log"
assert_link "$LEGACY_HOME/.local/bin/nteract-nightly" "$LEGACY_HOME/.local/share/nteract/nightly/nteract-nightly.AppImage"

note "CLI migration preserves an unrelated desktop launcher and reports the AppImage fallback"
DESKTOP_CONFLICT_HOME="$WORK/desktop-conflict-home"
DESKTOP_CONFLICT_PREFIX="$DESKTOP_CONFLICT_HOME/.local/share/nteract/stable"
mkdir -p "$DESKTOP_CONFLICT_HOME/.local/bin" "$DESKTOP_CONFLICT_PREFIX"
echo "existing app" > "$DESKTOP_CONFLICT_PREFIX/nteract.AppImage"
ln -s "$DESKTOP_CONFLICT_PREFIX/nteract.AppImage" "$DESKTOP_CONFLICT_HOME/.local/bin/nteract"
ln -s "$WORK/unrelated-desktop" "$DESKTOP_CONFLICT_HOME/.local/bin/nteract-desktop"
PATH="$WORK/shim-linux:$PATH" run_installer "$DESKTOP_CONFLICT_HOME" \
  --from-dir "$WORK/linux-assets" --cli > "$WORK/desktop-conflict-out.log" 2>&1
assert_link "$DESKTOP_CONFLICT_HOME/.local/bin/nteract" "$DESKTOP_CONFLICT_PREFIX/bin/nteract-cli"
assert_link "$DESKTOP_CONFLICT_HOME/.local/bin/nteract-desktop" "$WORK/unrelated-desktop"
grep -Fq "Launcher: $DESKTOP_CONFLICT_PREFIX/nteract.AppImage" "$WORK/desktop-conflict-out.log" || fail "conflicting desktop launcher should report direct AppImage path"
grep -qx "existing app" "$DESKTOP_CONFLICT_PREFIX/nteract.AppImage" || fail "CLI migration changed the existing app"

note "unknown commands and broken symlinks remain untouched, even with explicit selection"
for kind in file symlink; do
  CONFLICT_HOME="$WORK/conflict-$kind"
  mkdir -p "$CONFLICT_HOME/.local/bin"
  if [[ "$kind" == file ]]; then
    echo "unrelated executable" > "$CONFLICT_HOME/.local/bin/nteract"
  else
    ln -s "$WORK/unrelated-missing" "$CONFLICT_HOME/.local/bin/nteract"
  fi
  PATH="$WORK/shim-linux:$PATH" run_installer "$CONFLICT_HOME" \
    --from-dir "$WORK/linux-assets" --cli --default-cli > "$WORK/conflict-out.log" 2>&1
  if [[ "$kind" == file ]]; then
    grep -qx "unrelated executable" "$CONFLICT_HOME/.local/bin/nteract" || fail "unrelated command overwritten"
  else
    assert_link "$CONFLICT_HOME/.local/bin/nteract" "$WORK/unrelated-missing"
  fi
  assert_missing "$CONFLICT_HOME/.local/bin/.nteract-cli-target"
  grep -q 'Preserved existing' "$WORK/conflict-out.log" || fail "collision should explain preserved command"
done

note "legacy aliases preserve unrelated regular files and symlinks on both channels"
for channel in stable nightly; do
  suffix=""
  assets="$WORK/linux-assets"
  if [[ "$channel" == nightly ]]; then
    suffix="-nightly"
    assets="$WORK/nightly-assets"
  fi
  for kind in file symlink broken; do
    COMPAT_HOME="$WORK/compat-$channel-$kind"
    mkdir -p "$COMPAT_HOME/.local/bin"
    for name in "runt$suffix" "runtimed$suffix" "nteract-mcp$suffix"; do
      alias_path="$COMPAT_HOME/.local/bin/$name"
      case "$kind" in
        file) echo "user command $name" > "$alias_path" ;;
        symlink)
          echo "user target $name" > "$WORK/target-$channel-$name"
          ln -s "$WORK/target-$channel-$name" "$alias_path" ;;
        broken) ln -s "$WORK/missing-$channel-$name" "$alias_path" ;;
      esac
    done
    PATH="$WORK/shim-linux:$PATH" run_installer "$COMPAT_HOME" \
      --channel "$channel" --from-dir "$assets" --cli > "$WORK/compat-out.log" 2>&1
    for name in "runt$suffix" "runtimed$suffix" "nteract-mcp$suffix"; do
      alias_path="$COMPAT_HOME/.local/bin/$name"
      case "$kind" in
        file) grep -qx "user command $name" "$alias_path" || fail "legacy regular file overwritten: $name" ;;
        symlink) assert_link "$alias_path" "$WORK/target-$channel-$name" ;;
        broken) assert_link "$alias_path" "$WORK/missing-$channel-$name" ;;
      esac
      assert_missing "$COMPAT_HOME/.local/bin/.nteract-legacy-$name-target"
      grep -Fq "Installed backend available at $COMPAT_HOME/.local/share/nteract/$channel/bin/$name" "$WORK/compat-out.log" || fail "legacy collision should report real backend: $name"
    done
    assert_link "$COMPAT_HOME/.local/bin/nteract" "$COMPAT_HOME/.local/share/nteract/$channel/bin/nteract-cli"
  done
done

note "release checksums: manifest tool"
CHECKSUMS_TOOL="$SCRIPT_DIR/ci/release-checksums.sh"
STABLE_KEY="RWQ++KyX5QK7Kad7qdUsSgK1wSX8tyP9oi0E9izCzqYTkppp4Gf0UUF8"  # 29BB02E597ACF83E
NIGHTLY_KEY="RWS8zmGqVBZsmzkkrdjXigjInaliPhFjek6RO6+jUxxIzOfAJyo+oHhM" # 9B6C1654AA61CEBC
[[ "$(bash "$CHECKSUMS_TOOL" public-key "$INSTALLER" stable)" == "$STABLE_KEY" ]] || fail "public-key: stable should sign with key 29BB02E597ACF83E"
[[ "$(bash "$CHECKSUMS_TOOL" public-key "$INSTALLER" nightly)" == "$NIGHTLY_KEY" ]] || fail "public-key: nightly should sign with key 9B6C1654AA61CEBC"
grep -Fq "\"$NIGHTLY_KEY\"" <(awk '/^NTERACT_STABLE_RELEASE_KEYS=\(/,/^\)/' "$INSTALLER") && fail "the stable key list must not accept the nightly key"
grep -Fq "\"$STABLE_KEY\"" <(awk '/^NTERACT_NIGHTLY_RELEASE_KEYS=\(/,/^\)/' "$INSTALLER") && fail "the nightly key list must not accept the stable key"
if bash "$CHECKSUMS_TOOL" public-key "$INSTALLER" beta > /dev/null 2>&1; then
  fail "public-key: unknown channel should fail"
fi
MANIFEST_DIR="$WORK/manifest-assets"
mkdir -p "$MANIFEST_DIR/extra"
printf 'b\n' > "$MANIFEST_DIR/b-asset"
printf 'a\n' > "$MANIFEST_DIR/a-asset"
printf 'w\n' > "$MANIFEST_DIR/extra/wheel.whl"
printf 'stale\n' > "$MANIFEST_DIR/SHA256SUMS.minisig"
bash "$CHECKSUMS_TOOL" write "$MANIFEST_DIR" "$MANIFEST_DIR/extra" > /dev/null
[[ "$(awk '{print $2}' "$MANIFEST_DIR/SHA256SUMS" | tr '\n' ' ')" == "a-asset b-asset wheel.whl " ]] || fail "write: manifest should list sorted asset names and skip itself and its signature"
grep -Eqv '^[0-9a-f]{64}  [^ ]+$' "$MANIFEST_DIR/SHA256SUMS" && fail "write: manifest lines must be '<sha256>  <name>'"
printf 'dup\n' > "$MANIFEST_DIR/extra/a-asset"
if bash "$CHECKSUMS_TOOL" write "$MANIFEST_DIR" "$MANIFEST_DIR/extra" > /dev/null 2>&1; then
  fail "write: duplicate asset names across directories should fail"
fi
if RELEASE_CHECKSUMS_SIGNING_KEY="" RELEASE_CHECKSUMS_SIGNING_KEY_PASSWORD="x" \
  bash "$CHECKSUMS_TOOL" sign "$MANIFEST_DIR/SHA256SUMS" v1.0.0 > "$WORK/empty-key.log" 2>&1; then
  fail "sign: empty key secret should fail"
fi
grep -q "RELEASE_CHECKSUMS_SIGNING_KEY is empty" "$WORK/empty-key.log" || fail "sign: empty key secret should be named"

# Each case installs the Linux x64 CLI from a fresh fixture directory with an
# installer stamped like a release asset: a tag, and a public key.
VERIFY_TAG="v9.9.9-stable.202601010101"
make_checksum_fixture() {
  local dir="$1"
  make_linux_fixtures "$dir" "$WORK/verify-calls.log"
  bash "$CHECKSUMS_TOOL" write "$dir" > /dev/null
}
sign_fixture() {
  local dir="$1" tag="$2" key="$3"
  RELEASE_CHECKSUMS_SIGNING_KEY="$(base64 < "$key" | tr -d '\n')" \
    RELEASE_CHECKSUMS_SIGNING_KEY_PASSWORD="$TEST_KEY_PASSWORD" \
    RUNNER_TEMP="$WORK/runner-temp" \
    bash "$CHECKSUMS_TOOL" sign "$dir/SHA256SUMS" "$tag" > /dev/null
}
# stamp_installer <dest> <tag> <stable keys> [<nightly keys>]
# Keys are space-separated, first key first. Nightly defaults to stable's.
stamp_installer() {
  local dest="$1" tag="$2" stable="$3" nightly="${4:-$3}"
  sed -e "s/^DEFAULT_TAG=\"\"$/DEFAULT_TAG=\"$tag\"/" "$INSTALLER" |
    awk -v stable="$stable" -v nightly="$nightly" '
      function emit(keys,   n, i, list) {
        n = split(keys, list, " ")
        for (i = 1; i <= n; i++) print "  \"" list[i] "\""
      }
      $0 == "NTERACT_STABLE_RELEASE_KEYS=(" { print; emit(stable); skip = 1; next }
      $0 == "NTERACT_NIGHTLY_RELEASE_KEYS=(" { print; emit(nightly); skip = 1; next }
      skip && /^\)/ { skip = 0 }
      !skip { print }
    ' > "$dest"
  [[ "$(bash "$CHECKSUMS_TOOL" public-key "$dest" stable)" == "${stable%% *}" ]] || fail "stamp: stable keys not replaced"
  [[ "$(bash "$CHECKSUMS_TOOL" public-key "$dest" nightly)" == "${nightly%% *}" ]] || fail "stamp: nightly keys not replaced"
}
# verify_case <name> <pass|fail> <output text> <assets> [installer args...]
# Runs $CASE_INSTALLER with PATH=$CASE_PATH.
verify_case() {
  local name="$1" expect="$2" pattern="$3" assets="$4"
  shift 4
  local slug="${name// /-}"
  local home="$WORK/verify-home-$slug" out="$WORK/verify-out-$slug.log"
  local status=0
  INSTALLER_UNDER_TEST="$CASE_INSTALLER" PATH="$CASE_PATH" run_installer "$home" \
    --from-dir "$assets" --cli "$@" > "$out" 2>&1 || status=$?
  if [[ "$expect" == pass && "$status" != 0 ]]; then
    fail "$name: install should succeed (exit $status): $(tail -n 3 "$out")"
  elif [[ "$expect" == fail && "$status" == 0 ]]; then
    fail "$name: install should fail"
  fi
  if [[ "$expect" == fail ]]; then
    assert_missing "$home/.local/share/nteract/stable/bin/runt"
  else
    assert_link "$home/.local/bin/runt" "$home/.local/share/nteract/stable/bin/runt"
  fi
  grep -Fq -- "$pattern" "$out" || fail "$name: output should contain '$pattern': $(tail -n 3 "$out")"
}

# A PATH with every tool the installer and fixtures use, but no minisign.
NO_MINISIGN_PATH="$WORK/no-minisign-tools"
mkdir -p "$NO_MINISIGN_PATH"
for tool in awk basename bash cat chmod cp dirname env find grep head ln mkdir mktemp mv readlink rm sed sha256sum shasum tail tar tr wc; do
  if command -v "$tool" >/dev/null 2>&1; then
    ln -s "$(command -v "$tool")" "$NO_MINISIGN_PATH/$tool"
  fi
done
NO_MINISIGN_PATH="$WORK/shim-linux:$NO_MINISIGN_PATH"

note "release checksums: installer without a signature"
UNSIGNED_INSTALLER="$WORK/install-linux-release-release-key"
stamp_installer "$UNSIGNED_INSTALLER" "$VERIFY_TAG" "$STABLE_KEY" "$NIGHTLY_KEY"
CASE_INSTALLER="$UNSIGNED_INSTALLER"
CASE_PATH="$NO_MINISIGN_PATH"
make_linux_fixtures "$WORK/verify-no-sums" "$WORK/verify-calls.log"
verify_case "no checksum file" pass "Warning: this release has no SHA256SUMS" "$WORK/verify-no-sums"
make_checksum_fixture "$WORK/verify-good-sums"
verify_case "good checksums" pass "Checked 4 downloads against SHA256SUMS" "$WORK/verify-good-sums"
grep -Fq "no SHA256SUMS.minisig; the signature was not checked" "$WORK/verify-out-good-checksums.log" || fail "good checksums: should note the unchecked signature"
make_checksum_fixture "$WORK/verify-tampered"
printf 'tampered\n' >> "$WORK/verify-tampered/runtimed-linux-x64"
verify_case "tampered asset" fail "SHA-256 mismatch for runtimed-linux-x64" "$WORK/verify-tampered"
make_checksum_fixture "$WORK/verify-missing-line"
grep -v ' nteract-mcp-linux-x64$' "$WORK/verify-missing-line/SHA256SUMS" > "$WORK/verify-missing-line/SHA256SUMS.new"
mv "$WORK/verify-missing-line/SHA256SUMS.new" "$WORK/verify-missing-line/SHA256SUMS"
verify_case "missing checksum line" fail "SHA256SUMS has no single entry for nteract-mcp-linux-x64" "$WORK/verify-missing-line"
verify_case "require without checksum file" fail "has no SHA256SUMS; --require-signature" "$WORK/verify-no-sums" --require-signature
verify_case "require without signature" fail "has no SHA256SUMS.minisig; --require-signature" "$WORK/verify-good-sums" --require-signature
for value in TRUE True true; do
  NTERACT_REQUIRE_SIGNATURE="$value" verify_case "env require $value" fail "has no SHA256SUMS.minisig; --require-signature" "$WORK/verify-good-sums"
done
for value in 0 false FALSE ""; do
  NTERACT_REQUIRE_SIGNATURE="$value" verify_case "env require off ${value:-empty}" pass "no SHA256SUMS.minisig; the signature was not checked" "$WORK/verify-good-sums"
done
for value in yes 2 on; do
  NTERACT_REQUIRE_SIGNATURE="$value" verify_case "env require invalid $value" fail "NTERACT_REQUIRE_SIGNATURE must be 1, true, 0, false or empty, not '$value'" "$WORK/verify-good-sums"
done

MINISIGN_BIN="$(command -v minisign || true)"
if [[ -z "$MINISIGN_BIN" ]]; then
  if [[ "${NTERACT_TEST_REQUIRE_MINISIGN:-0}" == "1" ]]; then
    fail "minisign is not on PATH, and NTERACT_TEST_REQUIRE_MINISIGN=1 requires the signature cases"
  else
    echo "SKIP: minisign is not installed; signature cases did not run." >&2
  fi
else
  note "release checksums: signatures (throwaway keys)"
  TEST_KEY_PASSWORD="throwaway password"
  KEYS="$WORK/keys"
  mkdir -p "$KEYS"
  printf '%s\n%s\n' "$TEST_KEY_PASSWORD" "$TEST_KEY_PASSWORD" |
    minisign -G -p "$KEYS/good.pub" -s "$KEYS/good.key" > /dev/null 2>&1
  printf '%s\n%s\n' "$TEST_KEY_PASSWORD" "$TEST_KEY_PASSWORD" |
    minisign -G -p "$KEYS/other.pub" -s "$KEYS/other.key" > /dev/null 2>&1
  GOOD_PUB="$(sed -n 2p "$KEYS/good.pub")"
  SIGNED_INSTALLER="$WORK/install-linux-release-test-key"
  stamp_installer "$SIGNED_INSTALLER" "$VERIFY_TAG" "$GOOD_PUB"
  CASE_INSTALLER="$SIGNED_INSTALLER"
  WITH_MINISIGN_PATH="$WORK/with-minisign-tools"
  mkdir -p "$WITH_MINISIGN_PATH"
  ln -s "$MINISIGN_BIN" "$WITH_MINISIGN_PATH/minisign"
  WITH_MINISIGN_PATH="$WITH_MINISIGN_PATH:$NO_MINISIGN_PATH"

  make_checksum_fixture "$WORK/verify-signed"
  sign_fixture "$WORK/verify-signed" "$VERIFY_TAG" "$KEYS/good.key"
  assert_missing "$WORK/runner-temp/nteract-release-checksums-key"
  bash "$CHECKSUMS_TOOL" verify "$WORK/verify-signed/SHA256SUMS" "$VERIFY_TAG" "$GOOD_PUB" > /dev/null || fail "verify: good signature should verify"
  if bash "$CHECKSUMS_TOOL" verify "$WORK/verify-signed/SHA256SUMS" "$VERIFY_TAG" "$STABLE_KEY" > /dev/null 2>&1; then
    fail "verify: signature should not verify against a different key"
  fi
  if bash "$CHECKSUMS_TOOL" verify "$WORK/verify-signed/SHA256SUMS" "v9.9.8-stable.202512310101" "$GOOD_PUB" > /dev/null 2>&1; then
    fail "verify: signature should not verify for a different tag"
  fi

  CASE_PATH="$WITH_MINISIGN_PATH"
  verify_case "good signature" pass "Verified SHA256SUMS signature for $VERIFY_TAG" "$WORK/verify-signed"
  verify_case "good signature required" pass "Verified SHA256SUMS signature for $VERIFY_TAG" "$WORK/verify-signed" --require-signature
  NTERACT_REQUIRE_SIGNATURE=1 verify_case "env require without signature" fail "has no SHA256SUMS.minisig; --require-signature" "$WORK/verify-good-sums"

  make_checksum_fixture "$WORK/verify-bad-sig"
  sign_fixture "$WORK/verify-bad-sig" "$VERIFY_TAG" "$KEYS/other.key"
  verify_case "bad signature" fail "signature does not verify against any nteract stable release key" "$WORK/verify-bad-sig"

  # Accepted keys are a list per channel: an older key further down still
  # verifies, and another channel's key does not.
  OTHER_PUB="$(sed -n 2p "$KEYS/other.pub")"
  CASE_INSTALLER="$WORK/install-linux-release-rotated"
  stamp_installer "$CASE_INSTALLER" "$VERIFY_TAG" "$OTHER_PUB $GOOD_PUB"
  verify_case "older key in the list" pass "Verified SHA256SUMS signature for $VERIFY_TAG" "$WORK/verify-signed"
  CASE_INSTALLER="$WORK/install-linux-release-wrong-channel"
  stamp_installer "$CASE_INSTALLER" "$VERIFY_TAG" "$OTHER_PUB" "$GOOD_PUB"
  verify_case "nightly key on a stable install" fail "signature does not verify against any nteract stable release key" "$WORK/verify-signed"

  # The reverse: a nightly install rejects a manifest signed with the stable key.
  NIGHTLY_SIGNED="$WORK/verify-nightly-stable-signed"
  make_nightly_linux_fixtures "$NIGHTLY_SIGNED" "$WORK/verify-calls.log"
  bash "$CHECKSUMS_TOOL" write "$NIGHTLY_SIGNED" > /dev/null
  sign_fixture "$NIGHTLY_SIGNED" "v9.9.9-nightly.202601010101" "$KEYS/good.key"
  NIGHTLY_CASE_INSTALLER="$WORK/install-linux-release-nightly-wrong-key"
  stamp_installer "$NIGHTLY_CASE_INSTALLER" "" "$GOOD_PUB" "$OTHER_PUB"
  sed -e 's/^DEFAULT_CHANNEL="stable"$/DEFAULT_CHANNEL="nightly"/' \
    -e 's/^DEFAULT_TAG=""$/DEFAULT_TAG="v9.9.9-nightly.202601010101"/' \
    "$NIGHTLY_CASE_INSTALLER" > "$NIGHTLY_CASE_INSTALLER.stamped"
  status=0
  INSTALLER_UNDER_TEST="$NIGHTLY_CASE_INSTALLER.stamped" PATH="$WITH_MINISIGN_PATH" run_installer "$WORK/verify-home-stable-key-nightly" \
    --from-dir "$NIGHTLY_SIGNED" --cli > "$WORK/verify-out-stable-key-nightly.log" 2>&1 || status=$?
  [[ "$status" != 0 ]] || fail "stable key on a nightly install: install should fail"
  assert_missing "$WORK/verify-home-stable-key-nightly/.local/share/nteract/nightly/bin/runt-nightly"
  grep -Fq "signature does not verify against any nteract nightly release key" "$WORK/verify-out-stable-key-nightly.log" ||
    fail "stable key on a nightly install: should name the nightly key list"
  # With the right list, the same nightly manifest verifies.
  stamp_installer "$NIGHTLY_CASE_INSTALLER" "" "$OTHER_PUB" "$GOOD_PUB"
  sed -e 's/^DEFAULT_CHANNEL="stable"$/DEFAULT_CHANNEL="nightly"/' \
    -e 's/^DEFAULT_TAG=""$/DEFAULT_TAG="v9.9.9-nightly.202601010101"/' \
    "$NIGHTLY_CASE_INSTALLER" > "$NIGHTLY_CASE_INSTALLER.stamped"
  INSTALLER_UNDER_TEST="$NIGHTLY_CASE_INSTALLER.stamped" PATH="$WITH_MINISIGN_PATH" run_installer "$WORK/verify-home-nightly-key-nightly" \
    --from-dir "$NIGHTLY_SIGNED" --cli > "$WORK/verify-out-nightly-key-nightly.log" 2>&1 ||
    fail "nightly key on a nightly install: install should succeed: $(tail -n 3 "$WORK/verify-out-nightly-key-nightly.log")"
  grep -Fq "Verified SHA256SUMS signature for v9.9.9-nightly.202601010101" "$WORK/verify-out-nightly-key-nightly.log" ||
    fail "nightly key on a nightly install: should verify the signature"
  CASE_INSTALLER="$SIGNED_INSTALLER"

  make_checksum_fixture "$WORK/verify-other-tag"
  sign_fixture "$WORK/verify-other-tag" "v9.9.8-stable.202512310101" "$KEYS/good.key"
  verify_case "signature for another tag" fail "signed for 'nteract release v9.9.8-stable.202512310101'" "$WORK/verify-other-tag"

  make_checksum_fixture "$WORK/verify-signed-tampered"
  sign_fixture "$WORK/verify-signed-tampered" "$VERIFY_TAG" "$KEYS/good.key"
  printf 'tampered\n' >> "$WORK/verify-signed-tampered/runt-linux-x64"
  verify_case "signed manifest with tampered asset" fail "SHA-256 mismatch for runt-linux-x64" "$WORK/verify-signed-tampered"

  CASE_PATH="$NO_MINISIGN_PATH"
  verify_case "signature without minisign" pass "minisign is not on PATH; the signature was not checked" "$WORK/verify-signed"
  verify_case "require without minisign" fail "minisign is not on PATH; --require-signature" "$WORK/verify-signed" --require-signature

  # A checkout's installer knows no tag: it checks the key but cannot bind
  # the tag, which --require-signature refuses.
  UNSTAMPED_INSTALLER="$WORK/install-linux-release-test-key-unstamped"
  stamp_installer "$UNSTAMPED_INSTALLER" "" "$GOOD_PUB"
  CASE_INSTALLER="$UNSTAMPED_INSTALLER"
  CASE_PATH="$WITH_MINISIGN_PATH"
  verify_case "unknown tag" pass "no tag is known for --from-dir" "$WORK/verify-signed"
  verify_case "require with unknown tag" fail "No release tag is known for --from-dir" "$WORK/verify-signed" --require-signature
fi

note "release checksums: download paths decide 'missing' from the HTTP status"
# Fake servers for curl, GNU wget and BusyBox wget. Each serves
# <assets>/<name>; a file <assets>/.status-<name> forces that HTTP status, and
# a missing file answers 404. /releases/latest redirects to the tag in
# <assets>/.latest-tag.
DOWNLOAD_TAG="v9.9.7-stable.202512300101"
make_fake_curl() {
  local dir="$1" assets="$2" log="$3"
  mkdir -p "$dir"
  cat > "$dir/curl" <<EOF
#!/usr/bin/env bash
out="" format="" url=""
while [[ \$# -gt 0 ]]; do
  case "\$1" in
    --output) out="\$2"; shift 2 ;;
    --write-out) format="\$2"; shift 2 ;;
    -*) shift ;;
    *) url="\$1"; shift ;;
  esac
done
echo "curl \$url" >> "$log"
if [[ "\$url" == */releases/latest ]]; then
  [[ "\$format" != *url_effective* ]] || printf '%s' "\${url%/latest}/tag/\$(cat "$assets/.latest-tag")"
  exit 0
fi
asset="\${url##*/}"
code=200
if [[ -f "$assets/.status-\$asset" ]]; then
  code="\$(cat "$assets/.status-\$asset")"
elif [[ ! -f "$assets/\$asset" ]]; then
  code=404
fi
[[ "\$format" != *http_code* ]] || printf '%s' "\$code"
if [[ "\$code" != 200 ]]; then
  echo "curl: (22) The requested URL returned error: \$code" >&2
  exit 22
fi
cp "$assets/\$asset" "\$out"
EOF
  chmod 0755 "$dir/curl"
}
make_fake_wget() {
  local dir="$1" assets="$2" log="$3" flavor="$4"
  mkdir -p "$dir"
  cat > "$dir/wget" <<EOF
#!/usr/bin/env bash
out="" url=""
while [[ \$# -gt 0 ]]; do
  case "\$1" in
    -O) out="\$2"; shift 2 ;;
    -*) shift ;;
    *) url="\$1"; shift ;;
  esac
done
echo "wget \$url" >> "$log"
if [[ "\$url" == */releases/latest ]]; then
  echo "  HTTP/1.1 302 Found" >&2
  if [[ "$flavor" == busybox ]]; then
    echo "  location: \${url%/latest}/tag/\$(cat "$assets/.latest-tag")" >&2
  else
    echo "  Location: \${url%/latest}/tag/\$(cat "$assets/.latest-tag")" >&2
    echo "Location: \${url%/latest}/tag/\$(cat "$assets/.latest-tag") [following]" >&2
  fi
  echo "  HTTP/1.1 200 OK" >&2
  exit 0
fi
asset="\${url##*/}"
code=200
if [[ -f "$assets/.status-\$asset" ]]; then
  code="\$(cat "$assets/.status-\$asset")"
elif [[ ! -f "$assets/\$asset" ]]; then
  code=404
fi
if [[ "\$code" != 200 ]]; then
  if [[ "$flavor" == busybox ]]; then
    echo "wget: server returned error: HTTP/1.1 \$code Error" >&2
    exit 1
  fi
  echo "  HTTP/1.1 302 Found" >&2
  echo "  HTTP/1.1 \$code Error" >&2
  echo "ERROR \$code: Error." >&2
  exit 8
fi
echo "  HTTP/1.1 200 OK" >&2
cp "$assets/\$asset" "\$out"
EOF
  chmod 0755 "$dir/wget"
}
# download_case <name> <pass|fail> <output text> <tools dir> [installer args...]
download_case() {
  local name="$1" expect="$2" pattern="$3" tools="$4"
  shift 4
  local slug="${name// /-}"
  local home="$WORK/download-home-$slug" out="$WORK/download-out-$slug.log"
  local status=0
  INSTALLER_UNDER_TEST="$DOWNLOAD_INSTALLER" PATH="$tools:$NO_MINISIGN_PATH" run_installer "$home" \
    --cli "$@" > "$out" 2>&1 || status=$?
  if [[ "$expect" == pass && "$status" != 0 ]]; then
    fail "$name: install should succeed (exit $status): $(tail -n 3 "$out")"
  elif [[ "$expect" == fail && "$status" == 0 ]]; then
    fail "$name: install should fail"
  fi
  if [[ "$expect" == fail ]]; then
    assert_missing "$home/.local/share/nteract/stable/bin/runt"
  fi
  grep -Fq -- "$pattern" "$out" || fail "$name: output should contain '$pattern': $(tail -n 3 "$out")"
}

DOWNLOAD_INSTALLER="$WORK/install-linux-release-no-tag"
stamp_installer "$DOWNLOAD_INSTALLER" "" "$STABLE_KEY" "$NIGHTLY_KEY"
DOWNLOAD_ASSETS="$WORK/download-assets"
make_linux_fixtures "$DOWNLOAD_ASSETS" "$WORK/download-calls.log"
printf '%s\n' "$DOWNLOAD_TAG" > "$DOWNLOAD_ASSETS/.latest-tag"
for client in curl gnu-wget busybox-wget; do
  tools="$WORK/download-tools-$client"
  log="$WORK/download-$client.log"
  case "$client" in
    curl) make_fake_curl "$tools" "$DOWNLOAD_ASSETS" "$log" ;;
    gnu-wget) make_fake_wget "$tools" "$DOWNLOAD_ASSETS" "$log" gnu ;;
    busybox-wget) make_fake_wget "$tools" "$DOWNLOAD_ASSETS" "$log" busybox ;;
  esac
  rm -f "$DOWNLOAD_ASSETS/.status-SHA256SUMS"
  # No --tag and no stamped tag: the latest release is resolved once, and
  # every asset comes from that tag.
  download_case "$client latest tag and 404 checksums" pass "Warning: this release has no SHA256SUMS" "$tools"
  grep -q "/releases/download/$DOWNLOAD_TAG/runt-linux-x64" "$log" || fail "$client: assets should come from the resolved latest tag"
  grep -q "/releases/download/$DOWNLOAD_TAG/SHA256SUMS" "$log" || fail "$client: SHA256SUMS should come from the resolved latest tag"
  for code in 503 403 429; do
    printf '%s\n' "$code" > "$DOWNLOAD_ASSETS/.status-SHA256SUMS"
    download_case "$client checksums answer $code" fail "Could not download" "$tools" --tag "$DOWNLOAD_TAG"
  done
  rm -f "$DOWNLOAD_ASSETS/.status-SHA256SUMS"
done
rm -f "$DOWNLOAD_ASSETS/.latest-tag"
download_case "curl latest tag unresolved" fail "Could not resolve the latest release" "$WORK/download-tools-curl"
download_case "gnu-wget latest tag unresolved" fail "Could not resolve the latest release" "$WORK/download-tools-gnu-wget"

note "unsupported platform is rejected with guidance"
make_uname_shim "$WORK/shim-unsupported" "Linux" "armv7l"
if PATH="$WORK/shim-unsupported:$PATH" run_installer "$WORK/unsupported-home" \
  --from-dir "$WORK/linux-assets" > "$WORK/unsupported-out.log" 2>&1; then
  fail "unsupported platform should exit nonzero"
fi
grep -q "Unsupported platform" "$WORK/unsupported-out.log" || fail "unsupported: missing platform message"

if [[ "$FAILURES" -gt 0 ]]; then
  echo
  echo "$FAILURES failure(s)." >&2
  exit 1
fi
echo
echo "All install-release fixture tests passed."
