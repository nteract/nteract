make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "org.nteract.desktop"
refused_install wrong-channel "$WORK/wrong-channel-assets" "Nothing was replaced"

note "darwin default leaves a symlinked system app alone"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
mkdir -p "$NTERACT_SYSTEM_APPLICATIONS_DIR"
make_app_bundle "$WORK/managed-elsewhere/nteract.app" "org.nteract.desktop"
ln -s "$WORK/managed-elsewhere/nteract.app" "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app"
refused_install system-symlink "$WORK/darwin-assets" "is a symlink or is not"
assert_link "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "$WORK/managed-elsewhere/nteract.app"

note "darwin interrupted swap puts the previous app back"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "org.nteract.desktop"
# This mv ends the installer right after it sets the old app aside.
mkdir -p "$WORK/shim-interrupt"
cat > "$WORK/shim-interrupt/mv" <<EOF
#!/usr/bin/env bash
"$(command -v mv)" "\$@" || exit \$?
case "\${2:-}" in
  */.nteract-install.*/previous) kill -TERM "\$PPID" ;;
esac
EOF
chmod 0755 "$WORK/shim-interrupt/mv"
if PATH="$WORK/shim-interrupt:$WORK/shim-darwin:$PATH" run_installer "$WORK/interrupt-home" \
  --from-dir "$WORK/darwin-assets" --no-start > "$WORK/interrupt.log" 2>&1; then
  fail "darwin interrupt: install should not succeed"
fi
grep -qx "old runt" "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app/Contents/MacOS/runt" || fail "darwin interrupt: previous app should be back"
[[ -z "$(find "$NTERACT_SYSTEM_APPLICATIONS_DIR" -maxdepth 1 -name '.nteract-install.*')" ]] || fail "darwin interrupt: staging directory left behind"

note "darwin default app is readable by other accounts under a tight umask"
UMASK_HOME="$WORK/umask-home"
(umask 077 && darwin_install "$UMASK_HOME" "$WORK/darwin-assets")
UMASK_APP="$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app"
assert_file "$UMASK_APP/Contents/MacOS/notebook"
[[ -z "$(find "$UMASK_APP" ! -type l ! -perm -0044)" ]] || fail "darwin umask: app should be readable by everyone"
[[ -z "$(find "$UMASK_APP" -type d ! -perm -0011)" ]] || fail "darwin umask: app directories should be searchable by everyone"

note "darwin fails when the daemon service still points at a removed copy"
STUCK_HOME="$WORK/stuck-service-home"
make_app_bundle "$STUCK_HOME/Applications/nteract.app" "org.nteract.desktop"
mkdir -p "$STUCK_HOME/Library/LaunchAgents"
printf '<array>\n  <string>%s/Applications/nteract.app/Contents/MacOS/runtimed</string>\n</array>\n' \
  "$STUCK_HOME" > "$STUCK_HOME/Library/LaunchAgents/io.nteract.runtimed.plist"
if PATH="$WORK/shim-darwin:$PATH" run_installer "$STUCK_HOME" \
  --from-dir "$WORK/darwin-assets" --no-start > "$STUCK_HOME.log" 2>&1; then
  fail "darwin stuck service: install should fail"
fi
grep -q "still points into $STUCK_HOME/Applications/nteract.app" "$STUCK_HOME.log" || fail "darwin stuck service: should name the removed app"
grep -q "install complete" "$STUCK_HOME.log" && fail "darwin stuck service: should not report completion"

note "darwin default reports links on PATH from another command directory"
PATH_HOME="$WORK/path-link-home"
mkdir -p "$PATH_HOME/bin"
make_app_bundle "$PATH_HOME/Applications/nteract.app" "org.nteract.desktop"
ln -s "$PATH_HOME/Applications/nteract.app/Contents/MacOS/runt" "$PATH_HOME/bin/runt"
