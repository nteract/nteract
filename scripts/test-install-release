for link in "$NTERACT_SYSTEM_BIN_DIR/runt" "$STRAY_HOME/.local/bin/runtimed"; do
  grep -qF "Warning: $link points into a removed app" "$STRAY_HOME.log" || fail "darwin stray link: $link should be reported"
done
rm "$NTERACT_SYSTEM_BIN_DIR/runt"

# An install that is refused must leave the system app as it was.
# refused_install <name> <assets> <output text>
refused_install() {
  local name="$1" assets="$2" pattern="$3"
  local home="$WORK/refused-$name-home"
  make_app_bundle "$home/Applications/nteract.app" "org.nteract.desktop"
  if PATH="$WORK/shim-darwin:$PATH" \
    run_installer "$home" --from-dir "$assets" --no-start > "$home.log" 2>&1; then
    fail "darwin $name: install should fail"
  fi
  grep -qF -- "$pattern" "$home.log" || fail "darwin $name: output should contain '$pattern'"
  grep -qx "old runt" "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app/Contents/MacOS/runt" || fail "darwin $name: system app changed"
  assert_file "$home/Applications/nteract.app/Contents/MacOS/runt"
  assert_missing "$home/.local/bin/runt"
}

note "darwin default refuses to replace another app of the same name"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "io.nteract.nteract"
refused_install other-app "$WORK/darwin-assets" "is not a org.nteract.desktop app. It is unchanged"

note "darwin rejects an incomplete bundle before replacing the app"
mkdir -p "$WORK/incomplete-assets/stage/nteract.app/Contents/MacOS"
tar -czf "$WORK/incomplete-assets/nteract-stable-darwin-arm64.app.tar.gz" \
  -C "$WORK/incomplete-assets/stage" "nteract.app"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "org.nteract.desktop"
refused_install incomplete "$WORK/incomplete-assets" "Bundle is missing expected executable"

note "darwin replace leaves other files beside the app alone"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
for kept in nteract.app.old nteract.app.new; do
  mkdir -p "$NTERACT_SYSTEM_APPLICATIONS_DIR/$kept"
  echo "user backup" > "$NTERACT_SYSTEM_APPLICATIONS_DIR/$kept/marker"
done
make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "org.nteract.desktop"
BACKUP_HOME="$WORK/backup-home"
PATH="$WORK/shim-darwin:$PATH" run_installer "$BACKUP_HOME" \
  --from-dir "$WORK/darwin-assets" --no-start > "$BACKUP_HOME.log" 2>&1 || fail "darwin backup: install failed"
assert_file "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app/Contents/MacOS/runt"
for kept in nteract.app.old nteract.app.new; do
  assert_file "$NTERACT_SYSTEM_APPLICATIONS_DIR/$kept/marker"
done

note "darwin rejects a bundle without the desktop executable"
make_darwin_fixtures "$WORK/no-desktop-assets" "$WORK/no-desktop-calls.log"
mkdir -p "$WORK/no-desktop-assets/stage"
tar -xzf "$WORK/no-desktop-assets/nteract-stable-darwin-arm64.app.tar.gz" -C "$WORK/no-desktop-assets/stage"
rm "$WORK/no-desktop-assets/stage/nteract.app/Contents/MacOS/notebook"
tar -czf "$WORK/no-desktop-assets/nteract-stable-darwin-arm64.app.tar.gz" \
  -C "$WORK/no-desktop-assets/stage" "nteract.app"
rm -rf "$NTERACT_SYSTEM_APPLICATIONS_DIR"
make_app_bundle "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app" "org.nteract.desktop"
refused_install no-desktop "$WORK/no-desktop-assets" "Contents/MacOS/notebook"

note "darwin default rejects a bundle for another channel"
