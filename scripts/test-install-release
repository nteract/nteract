assert_link "$LEGACY_HOME/.local/bin/nteract-desktop" "$LEGACY_PREFIX/nteract.AppImage"
grep -Fq "Launcher: $LEGACY_HOME/.local/bin/nteract-desktop" "$WORK/legacy-out.log" || fail "CLI migration should report the preserved desktop launcher"
grep -qx "existing app" "$LEGACY_PREFIX/nteract.AppImage" || fail "headless migration changed desktop app"
