grep -qF "Warning: $PATH_HOME/bin/runt points into a removed app" "$PATH_HOME.log" || fail "darwin PATH link: should be reported"

note "darwin explicit --applications-dir and --cli remove no other copy"
for mode in explicit user-dir cli; do
  KEEP_HOME="$WORK/keep-$mode-home"
  KEEP_APP="$KEEP_HOME/Applications/nteract.app"
  make_app_bundle "$KEEP_APP" "org.nteract.desktop"
  case "$mode" in
    explicit) darwin_install "$KEEP_HOME" "$WORK/darwin-assets" --applications-dir "$WORK/keep-explicit-apps" ;;
    user-dir) darwin_install "$KEEP_HOME" "$WORK/darwin-assets" --applications-dir "$KEEP_HOME/Applications" ;;
    cli) darwin_install "$KEEP_HOME" "$WORK/darwin-assets" --cli ;;
  esac
  assert_file "$KEEP_APP/Contents/MacOS/runt"
  assert_missing "$NTERACT_SYSTEM_APPLICATIONS_DIR/nteract.app"
  grep -q "Removed the older copy" "$KEEP_HOME.log" && fail "darwin $mode: nothing should be removed"
done

# Permission cases mean nothing for root, which can write anywhere.
if [[ "$(id -u)" != "0" ]]; then
  note "darwin default stops before any write when Applications is not writable"
  LOCKED_HOME="$WORK/locked-home"
  LOCKED_APPS="$WORK/locked-applications"
  mkdir -p "$LOCKED_APPS"
  chmod 0555 "$LOCKED_APPS"
  make_app_bundle "$LOCKED_HOME/Applications/nteract.app" "org.nteract.desktop"
  if NTERACT_SYSTEM_APPLICATIONS_DIR="$LOCKED_APPS" PATH="$WORK/shim-darwin:$PATH" \
    run_installer "$LOCKED_HOME" --from-dir "$WORK/darwin-assets" --no-start > "$LOCKED_HOME.log" 2>&1; then
    fail "darwin not writable: install should fail"
  fi
  grep -qF -- "--applications-dir \"$LOCKED_HOME/Applications\"" "$LOCKED_HOME.log" || fail "darwin not writable: should name the per-user option"
  assert_file "$LOCKED_HOME/Applications/nteract.app/Contents/MacOS/runt"
  assert_missing "$LOCKED_HOME/.local"

  note "darwin install leaves a bundle it cannot replace unchanged"
  OWNED_HOME="$WORK/owned-home"
  OWNED_APPS="$WORK/owned-applications"
  make_app_bundle "$OWNED_APPS/nteract.app" "org.nteract.desktop"
  chmod 0555 "$OWNED_APPS/nteract.app/Contents/MacOS"
  make_app_bundle "$OWNED_HOME/Applications/nteract.app" "org.nteract.desktop"
  if NTERACT_SYSTEM_APPLICATIONS_DIR="$OWNED_APPS" PATH="$WORK/shim-darwin:$PATH" \
    run_installer "$OWNED_HOME" --from-dir "$WORK/darwin-assets" --no-start > "$OWNED_HOME.log" 2>&1; then
    fail "darwin unreplaceable bundle: install should fail"
  fi
  grep -qx "old runt" "$OWNED_APPS/nteract.app/Contents/MacOS/runt" || fail "darwin unreplaceable bundle: existing app changed"
  assert_file "$OWNED_HOME/Applications/nteract.app/Contents/MacOS/runt"
  assert_missing "$OWNED_HOME/.local/bin/runt"
  chmod 0755 "$OWNED_APPS/nteract.app/Contents/MacOS" "$LOCKED_APPS"
fi

note "darwin headless install"
HEADLESS_HOME="$WORK/headless-home"
