#!/usr/bin/env bash
# Install a published nteract release for the current user (Linux x64 /
# ARM64, macOS Apple silicon / Intel). The file keeps its historical
# `install-linux-release` name because released installers and
# https://sh.nteract.io fetch it by that asset name.
#
# Entrypoint:
#   curl --proto '=https' --tlsv1.2 -sSf https://sh.nteract.io | bash
#
# Linux installs the AppImage plus runt/runtimed/nteract-mcp sidecars into a
# durable per-user directory and links commands into ~/.local/bin. macOS
# installs the signed .app bundle (which carries the same sidecars in
# Contents/MacOS) into /Applications, where the DMG puts it, and links the
# commands from there. The commands and daemon service stay per-user.
# Desktop installs repair/install the per-user daemon service with
# `nteract daemon doctor --fix` (systemd on Linux, launchd on macOS) and start
# it by default. CLI-only installs leave runtime services alone.
#
# Downloads are checked before anything is installed. When the release has a
# SHA256SUMS asset, every downloaded asset must match its line. When it also
# has SHA256SUMS.minisig and `minisign` is on PATH, the signature must verify
# against a key in the installed channel's key list and its trusted comment
# must name the tag being installed. Releases without SHA256SUMS install with a
# warning. --require-signature (or NTERACT_REQUIRE_SIGNATURE=1) makes the
# checksum file, the signature and minisign all mandatory.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/install-linux-release [--tag v2.4.1-stable.YYYYMMDDHHMM]
  scripts/install-linux-release --channel nightly --tag v2.4.1-nightly.YYYYMMDDHHMM
  scripts/install-linux-release --from-dir /path/to/release-assets
  scripts/install-linux-release --headless   # remote workstations, JupyterHub

Options:
  --tag <tag>          Download artifacts from a GitHub release tag.
                       Defaults to GitHub's latest non-prerelease release.
  --from-dir <dir>     Install artifacts from a local directory instead of GitHub.
  --repo <owner/repo>  GitHub repository (default: nteract/nteract).
  --channel <name>     stable or nightly (default: stable). Nightly requires --tag.
  --prefix <dir>       Install root (default: $XDG_DATA_HOME/nteract/<channel>,
                       or ~/.local/share/nteract/<channel>).
  --bin-dir <dir>      Symlink directory (default: ~/.local/bin).
  --cli, --headless    Install the CLI and runtime/MCP backends without
                       installing or starting any daemon service.
                       For remote workstations (Outerbounds,
                       JupyterHub) that offer compute to hosted notebooks.
                       See docs/runbooks/remote-workstation.md.
  --applications-dir <dir>
                       macOS only: where the .app bundle is installed
                       (default: /Applications, like the DMG). The default
                       also removes this channel's copy from ~/Applications;
                       with this option no other copy is removed.
  --no-start           Install/repair the daemon service but do not start it.
                       Applies to desktop installs only.
  --default-cli        Select this installation for the shared nteract command.
                       Existing unrelated commands are always preserved.
  --require-signature  Fail unless the release's SHA256SUMS, its minisign
                       signature and a local `minisign` are all present and
                       verify. Also set by NTERACT_REQUIRE_SIGNATURE=1
                       (or true); 0, false and empty leave it off.
  -h, --help           Show this help.

Installs, for stable on Linux (<arch> is x64 or arm64):
  nteract-stable-linux-<arch>.AppImage -> <prefix>/nteract.AppImage   (unless --headless)
  runt-linux-<arch>                    -> <prefix>/bin/runt
  nteract-cli-linux-<arch>             -> <prefix>/bin/nteract-cli
  runtimed-linux-<arch>                -> <prefix>/bin/runtimed
  nteract-mcp-linux-<arch>             -> <prefix>/bin/nteract-mcp

For stable on macOS (arm64/x64), one bundle carries app and sidecars:
  nteract-stable-darwin-<arch>.app.tar.gz -> /Applications/nteract.app
  (--headless keeps the bundle under <prefix> instead and skips
   Applications entirely; commands link to <bundle>/Contents/MacOS)

Then links:
  ~/.local/bin/nteract   (shared CLI; retains the selected installation)
  ~/.local/bin/nteract-desktop (Linux desktop AppImage)
  ~/.local/bin/runt
  ~/.local/bin/runtimed
  ~/.local/bin/nteract-mcp

For nightly, legacy commands remain channel-suffixed:
  ~/.local/bin/nteract-desktop-nightly
  ~/.local/bin/runt-nightly
  ~/.local/bin/runtimed-nightly
  ~/.local/bin/nteract-mcp-nightly
USAGE
}

require_option_value() {
  local option="$1"
  local value="${2:-}"
  if [[ -z "$value" || "$value" == -* ]]; then
    echo "$option requires a value." >&2
    usage >&2
    exit 2
  fi
}

case "$(uname -s):$(uname -m)" in
  Linux:x86_64|Linux:amd64)
    OS="linux"
    ARCH="x64"
    ;;
  Linux:aarch64|Linux:arm64)
    OS="linux"
    ARCH="arm64"
    ;;
  Darwin:arm64)
    OS="darwin"
    ARCH="arm64"
    ;;
  Darwin:x86_64)
    OS="darwin"
    ARCH="x64"
    ;;
  *)
    echo "Unsupported platform: $(uname -s) $(uname -m)." >&2
    echo "Release assets exist for Linux (x64, ARM64) and macOS (Apple silicon, Intel)." >&2
    echo "Windows users: download the installer from https://github.com/nteract/nteract/releases" >&2
    exit 1
    ;;
esac

REPO="nteract/nteract"
# release-common.yml stamps these in the uploaded release asset so a copied
# release installer with no args installs the exact channel and tag it came from.
DEFAULT_CHANNEL="stable"
DEFAULT_TAG=""
# Minisign keys accepted for each channel's SHA256SUMS, one quoted key per
# line. The first entry is the key the release workflow signs that channel
# with today, and it checks each signature against that entry before
# publishing. Later entries are older keys that releases still in use were
# signed with. A rotation adds the new key at the top of the list. Stable and
# nightly use separate keys: nightly signs unattended, stable behind a
# reviewer, so a leaked nightly key must not verify a stable release. Neither
# list holds the other channel's key.
NTERACT_STABLE_RELEASE_KEYS=(
  "RWQ++KyX5QK7Kad7qdUsSgK1wSX8tyP9oi0E9izCzqYTkppp4Gf0UUF8" # 29BB02E597ACF83E
)
NTERACT_NIGHTLY_RELEASE_KEYS=(
  "RWS8zmGqVBZsmzkkrdjXigjInaliPhFjek6RO6+jUxxIzOfAJyo+oHhM" # 9B6C1654AA61CEBC
)
CHANNEL="$DEFAULT_CHANNEL"
TAG=""
FROM_DIR=""
NO_START=0
HEADLESS=0
DEFAULT_CLI=0
# A security switch is never ignored: values other than these stop the install.
case "${NTERACT_REQUIRE_SIGNATURE:-}" in
  1|[Tt][Rr][Uu][Ee]) REQUIRE_SIGNATURE=1 ;;
  ""|0|[Ff][Aa][Ll][Ss][Ee]) REQUIRE_SIGNATURE=0 ;;
  *)
    echo "NTERACT_REQUIRE_SIGNATURE must be 1, true, 0, false or empty, not '$NTERACT_REQUIRE_SIGNATURE'." >&2
    exit 2
    ;;
esac
XDG_DATA_HOME_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}"
PREFIX=""
BIN_DIR="$HOME/.local/bin"
APPLICATIONS_DIR=""
# The fixture tests point this at a sandbox so they never touch the host's
# /Applications. App lookup only searches the real one.
SYSTEM_APPLICATIONS_DIR="${NTERACT_SYSTEM_APPLICATIONS_DIR:-/Applications}"
# Where a legacy command link into an app bundle may live, and the plist reader
# macOS ships. The fixture tests override both.
SYSTEM_BIN_DIR="${NTERACT_SYSTEM_BIN_DIR:-/usr/local/bin}"
PLIST_BUDDY="${NTERACT_PLIST_BUDDY:-/usr/libexec/PlistBuddy}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tag)
      require_option_value "$1" "${2:-}"
      TAG="${2:-}"
      shift 2
      ;;
    --from-dir)
      require_option_value "$1" "${2:-}"
      FROM_DIR="${2:-}"
      shift 2
      ;;
    --repo)
      require_option_value "$1" "${2:-}"
      REPO="${2:-}"
      shift 2
      ;;
    --channel)
      require_option_value "$1" "${2:-}"
      CHANNEL="${2:-}"
      shift 2
      ;;
    --prefix)
      require_option_value "$1" "${2:-}"
      PREFIX="${2:-}"
      shift 2
      ;;
    --bin-dir)
      require_option_value "$1" "${2:-}"
      BIN_DIR="${2:-}"
      shift 2
      ;;
    --applications-dir)
      require_option_value "$1" "${2:-}"
      APPLICATIONS_DIR="${2:-}"
      shift 2
      ;;
    --cli|--headless)
      HEADLESS=1
      shift
      ;;
    --default-cli)
      DEFAULT_CLI=1
      shift
      ;;
    --no-start)
      NO_START=1
      shift
      ;;
    --require-signature)
      REQUIRE_SIGNATURE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$TAG" && -z "$FROM_DIR" && "$CHANNEL" == "$DEFAULT_CHANNEL" && -n "$DEFAULT_TAG" ]]; then
  TAG="$DEFAULT_TAG"
fi

if [[ -n "$TAG" && -n "$FROM_DIR" ]]; then
  echo "Use either --tag or --from-dir, not both." >&2
  exit 2
fi
if [[ "$CHANNEL" != "stable" && "$CHANNEL" != "nightly" ]]; then
  echo "--channel must be stable or nightly." >&2
  exit 2
fi
if [[ "$CHANNEL" == "nightly" && -z "$TAG" && -z "$FROM_DIR" ]]; then
  echo "Nightly installs require --tag until a nightly channel endpoint exists." >&2
  exit 2
fi

# A macOS desktop install without --applications-dir targets the DMG's
# location. There is no fallback directory: a second location is how two
# copies of one app come to exist.
DEFAULT_APPLICATIONS_DIR=0
if [[ "$OS" == "darwin" && "$HEADLESS" == "0" && -z "$APPLICATIONS_DIR" ]]; then
  DEFAULT_APPLICATIONS_DIR=1
  APPLICATIONS_DIR="$SYSTEM_APPLICATIONS_DIR"
  if [[ ! -d "$APPLICATIONS_DIR" || ! -w "$APPLICATIONS_DIR" ]]; then
    echo "This account cannot write to $APPLICATIONS_DIR. Nothing was installed." >&2
    echo "Install the DMG with an administrator account, or install a copy for this user only:" >&2
    echo "  --applications-dir \"$HOME/Applications\"" >&2
    exit 1
  fi
fi

if [[ -z "$PREFIX" ]]; then
  PREFIX="$XDG_DATA_HOME_DEFAULT/nteract/$CHANNEL"
fi

if [[ "$CHANNEL" == "stable" ]]; then
  APPIMAGE_ASSET="nteract-stable-linux-$ARCH.AppImage"
  CLI_ASSET="runt-linux-$ARCH"
  GLOBAL_CLI_ASSET="nteract-cli-linux-$ARCH"
  DAEMON_ASSET="runtimed-linux-$ARCH"
  MCP_ASSET="nteract-mcp-linux-$ARCH"
  CLI_NAME="runt"
  DAEMON_NAME="runtimed"
  MCP_NAME="nteract-mcp"
  APPIMAGE_NAME="nteract"
else
  APPIMAGE_ASSET="nteract-nightly-linux-$ARCH.AppImage"
  CLI_ASSET="runt-nightly-linux-$ARCH"
  GLOBAL_CLI_ASSET="nteract-cli-nightly-linux-$ARCH"
  DAEMON_ASSET="runtimed-nightly-linux-$ARCH"
  MCP_ASSET="nteract-mcp-nightly-linux-$ARCH"
  CLI_NAME="runt-nightly"
  DAEMON_NAME="runtimed-nightly"
  MCP_NAME="nteract-mcp-nightly"
  APPIMAGE_NAME="nteract-nightly"
fi

# One macOS bundle carries the app and the runt/runtimed/nteract-mcp sidecars
# in Contents/MacOS; there are no standalone darwin daemon/mcp assets.
BUNDLE_ASSET="nteract-$CHANNEL-darwin-$ARCH.app.tar.gz"
BUNDLE_ID="org.nteract.desktop"
[[ "$CHANNEL" != "nightly" ]] || BUNDLE_ID="org.nteract.desktop.nightly"

APPIMAGE_DEST="$PREFIX/$APPIMAGE_NAME.AppImage"
SIDE_BIN_DIR="$PREFIX/bin"
TMP_DIR="$(mktemp -d)"
APP_DEST=""
SWAP_STAGING=""
cleanup() {
  # An interrupted app swap leaves the previous bundle in its staging
  # directory. Put it back; keep the directory if that fails.
  if [[ -n "$SWAP_STAGING" ]]; then
    local previous="$SWAP_STAGING/previous"
    if [[ ( -e "$previous" || -L "$previous" ) && ! -e "$APP_DEST" && ! -L "$APP_DEST" ]]; then
      mv "$previous" "$APP_DEST" || true
    fi
    [[ -e "$previous" || -L "$previous" ]] || rm -rf "$SWAP_STAGING"
  fi
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

base_url() {
  printf 'https://github.com/%s/releases/download/%s' "$REPO" "$TAG"
}

download_url() {
  local url="$1"
  local dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --show-error --silent "$url" --output "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$dest" "$url"
  else
    echo "curl or wget is required to install nteract." >&2
    exit 1
  fi
}

FETCHED_ASSETS=()
FETCHED_PATHS=()

fetch_asset() {
  local asset="$1"
  local dest="$2"
  FETCHED_ASSETS+=("$asset")
  FETCHED_PATHS+=("$dest")
  if [[ -n "$FROM_DIR" ]]; then
    local src="$FROM_DIR/$asset"
    if [[ ! -f "$src" ]]; then
      echo "Missing artifact: $src" >&2
      exit 1
    fi
    echo "Using $src"
    cp "$src" "$dest"
  else
    local url
    url="$(base_url)/$asset"
    echo "Downloading $url"
    download_url "$url" "$dest"
  fi
  chmod 0755 "$dest"
}

# Last HTTP status in a server response log. GNU wget -S prints
# "  HTTP/1.1 404 Not Found" per response; BusyBox wget prints
# "server returned error: HTTP/1.1 404 Not Found". Redirects come first, so
# the last status is the final answer. Prints nothing when none was seen.
last_http_status() {
  local line status="" pattern='HTTP/[0-9.]+ ([0-9][0-9][0-9])'
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $pattern ]]; then
      status="${BASH_REMATCH[1]}"
    fi
  done < "$1"
  printf '%s' "$status"
}

# Fetch a release file that older releases lack. Returns 1 only when the
# server's final answer is HTTP 404: the release does not have the file. Any
# other failure (403, 429, 5xx, DNS, TLS) stops the install, so a flaky or
# blocked network never reads as "this release has no checksums".
fetch_optional() {
  local asset="$1"
  local dest="$2"
  rm -f "$dest"
  if [[ -n "$FROM_DIR" ]]; then
    [[ -f "$FROM_DIR/$asset" ]] || return 1
    cp "$FROM_DIR/$asset" "$dest"
    return 0
  fi
  local url
  url="$(base_url)/$asset"
  if command -v curl >/dev/null 2>&1; then
    local code="" status=0
    code="$(curl --fail --location --silent --show-error --output "$dest" \
      --write-out '%{http_code}' "$url" 2>"$TMP_DIR/curl-error")" || status=$?
    if [[ "$status" == 0 ]]; then
      return 0
    fi
    rm -f "$dest"
    [[ "$code" != "404" ]] || return 1
    cat "$TMP_DIR/curl-error" >&2
    echo "Could not download $url" >&2
    exit 1
  elif command -v wget >/dev/null 2>&1; then
    local status=0
    wget -S -O "$dest" "$url" 2>"$TMP_DIR/wget-response" || status=$?
    if [[ "$status" == 0 ]]; then
      return 0
    fi
    rm -f "$dest"
    [[ "$(last_http_status "$TMP_DIR/wget-response")" != "404" ]] || return 1
    printf '%s\n' "$(<"$TMP_DIR/wget-response")" >&2
    echo "Could not download $url" >&2
    exit 1
  else
    echo "curl or wget is required to install nteract." >&2
    exit 1
  fi
}

# A tag the installer can bind the signature to: GitHub's latest release is
# resolved once, so every asset comes from that one release.
resolve_latest_tag() {
  local url="https://github.com/$REPO/releases/latest"
  local effective=""
  if command -v curl >/dev/null 2>&1; then
    effective="$(curl --fail --location --silent --show-error --output /dev/null \
      --write-out '%{url_effective}' "$url")" || effective=""
  elif command -v wget >/dev/null 2>&1; then
    # Follow the redirect and keep the last Location header that names a tag.
    # wget's exit status is ignored: the headers decide.
    wget -S --spider "$url" >"$TMP_DIR/wget-latest" 2>&1 || true
    local line pattern='[Ll]ocation: *([^[:space:]]*/releases/tag/[^[:space:]]+)'
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ $pattern ]]; then
        effective="${BASH_REMATCH[1]}"
      fi
    done < "$TMP_DIR/wget-latest"
  fi
  local tag="${effective##*/releases/tag/}"
  if [[ -z "$effective" || "$tag" == "$effective" || -z "$tag" || "$tag" == */* ]]; then
    echo "Could not resolve the latest release of $REPO. Pass --tag <tag>." >&2
    exit 1
  fi
  printf '%s' "$tag"
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "sha256sum or shasum is required to check this release's SHA256SUMS." >&2
    exit 1
  fi
}

# Check the signature on SHA256SUMS, then every fetched asset against it.
# Runs before any file is installed.
verify_downloads() {
  local sums="$TMP_DIR/SHA256SUMS"
  local sig="$sums.minisig"
  if ! fetch_optional SHA256SUMS "$sums"; then
    if [[ "$REQUIRE_SIGNATURE" == "1" ]]; then
      echo "This release has no SHA256SUMS; --require-signature cannot be met." >&2
      exit 1
    fi
    echo "Warning: this release has no SHA256SUMS; downloads were not checked." >&2
    return 0
  fi

  local has_sig=0 has_minisign=0
  if fetch_optional SHA256SUMS.minisig "$sig"; then
    has_sig=1
  fi
  if command -v minisign >/dev/null 2>&1; then
    has_minisign=1
  fi

  if [[ "$has_sig" == "1" && "$has_minisign" == "1" ]]; then
    if [[ -z "$EXPECTED_TAG" && "$REQUIRE_SIGNATURE" == "1" ]]; then
      echo "No release tag is known for --from-dir, so the signature cannot be bound to a release." >&2
      echo "Use the install-linux-release asset from the same release." >&2
      exit 1
    fi
    local comment="" key verified=0
    local keys=("${NTERACT_STABLE_RELEASE_KEYS[@]}")
    [[ "$CHANNEL" != "nightly" ]] || keys=("${NTERACT_NIGHTLY_RELEASE_KEYS[@]}")
    for key in "${keys[@]}"; do
      if comment="$(minisign -V -m "$sums" -x "$sig" -P "$key" -Q 2>/dev/null)"; then
        verified=1
        break
      fi
    done
    if [[ "$verified" != "1" ]]; then
      echo "SHA256SUMS signature does not verify against any nteract $CHANNEL release key. Not installing." >&2
      exit 1
    fi
    if [[ -n "$EXPECTED_TAG" ]]; then
      if [[ "$comment" != "nteract release $EXPECTED_TAG" ]]; then
        echo "SHA256SUMS is signed for '$comment', not 'nteract release $EXPECTED_TAG'. Not installing." >&2
        exit 1
      fi
      echo "Verified SHA256SUMS signature for $EXPECTED_TAG"
    else
      echo "Note: SHA256SUMS signature verified ('$comment'); no tag is known for --from-dir, so the tag was not matched." >&2
    fi
  elif [[ "$REQUIRE_SIGNATURE" == "1" ]]; then
    if [[ "$has_sig" == "0" ]]; then
      echo "This release has no SHA256SUMS.minisig; --require-signature cannot be met." >&2
    else
      echo "minisign is not on PATH; --require-signature cannot be met." >&2
    fi
    exit 1
  elif [[ "$has_sig" == "0" ]]; then
    echo "Note: this release has no SHA256SUMS.minisig; the signature was not checked." >&2
  else
    echo "Note: minisign is not on PATH; the signature was not checked. Install minisign to check it; --require-signature makes it mandatory." >&2
  fi

  local i asset expected actual
  for i in "${!FETCHED_ASSETS[@]}"; do
    asset="${FETCHED_ASSETS[$i]}"
    expected="$(awk -v name="$asset" '$2 == name || $2 == "*" name { print $1; n++ } END { if (n != 1) exit 1 }' "$sums")" || {
      echo "SHA256SUMS has no single entry for $asset. Not installing." >&2
      exit 1
    }
    actual="$(sha256_of "${FETCHED_PATHS[$i]}")"
    if [[ "$actual" != "$expected" ]]; then
      echo "SHA-256 mismatch for $asset: expected $expected, got $actual. Not installing." >&2
      exit 1
    fi
  done
  echo "Checked ${#FETCHED_ASSETS[@]} downloads against SHA256SUMS"
}

atomic_install() {
  local src="$1"
  local dest="$2"
  mkdir -p "$(dirname "$dest")"
  local tmp="$dest.new"
  cp "$src" "$tmp"
  chmod 0755 "$tmp"
  mv -f "$tmp" "$dest"
  echo "Installed $dest"
}

install_app_bundle() {
  local archive="$1"
  local dest_dir="$2"

  local extract_dir="$TMP_DIR/bundle"
  mkdir -p "$extract_dir"
  tar -xzf "$archive" -C "$extract_dir"
  local app_src
  app_src="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -name '*.app' -type d | head -n 1)"
  if [[ -z "$app_src" ]]; then
    echo "No .app bundle found inside $archive" >&2
    exit 1
  fi
  mkdir -p "$dest_dir"
  dest_dir="$(cd "$dest_dir" && pwd -L)"
  APP_BASENAME="$(basename "$app_src")"
  APP_DEST="$dest_dir/$APP_BASENAME"

  # Everything that can refuse the install runs before the destination changes.
  # `notebook` is the desktop app; the rest are its sidecars.
  local executable
  for executable in notebook runt runtimed nteract-mcp nteract-cli; do
    if [[ ! -x "$app_src/Contents/MacOS/$executable" ]]; then
      echo "Bundle is missing expected executable: Contents/MacOS/$executable in $archive" >&2
      exit 1
    fi
  done

  # A default install replaces the shared app and removes older copies, so the
  # incoming bundle must be this channel's app.
  if [[ "$DEFAULT_APPLICATIONS_DIR" == "1" ]]; then
    if [[ "$(bundle_identifier_of "$app_src")" != "$BUNDLE_ID" ]]; then
      echo "The app in $archive is not a $BUNDLE_ID app. Nothing was replaced." >&2
      exit 1
    fi
    # Other accounts run the shared app, whatever this shell's umask is.
    chmod -R a+rX "$app_src"
  fi

  # The default destination is shared by every account, and nothing says the
  # user meant to replace whatever has this name there.
  if [[ "$DEFAULT_APPLICATIONS_DIR" == "1" && ( -e "$APP_DEST" || -L "$APP_DEST" ) ]] &&
     [[ -L "$APP_DEST" || "$(bundle_identifier_of "$APP_DEST")" != "$BUNDLE_ID" ]]; then
    echo "Cannot replace $APP_DEST: it is a symlink or is not a $BUNDLE_ID app. It is unchanged." >&2
    echo "Move it out of the way and run the installer again, or pass --applications-dir." >&2
    exit 1
  fi

  # A bundle another account or a package installed can sit in a directory
  # this user may write.
  local part
  for part in "$APP_DEST" "$APP_DEST/Contents" "$APP_DEST/Contents/MacOS"; do
    if [[ -e "$part" && ! -w "$part" ]]; then
      echo "Cannot replace $APP_DEST: this account cannot write to $part. The existing app is unchanged." >&2
      exit 1
    fi
  done

  # Stage inside a directory this run creates, on the destination's volume.
  # The existing bundle is renamed aside, so a refused rename leaves it whole.
  local staging
  staging="$(mktemp -d "$dest_dir/.nteract-install.XXXXXX")"
  SWAP_STAGING="$staging"
  mv "$app_src" "$staging/new"
  if [[ -e "$APP_DEST" || -L "$APP_DEST" ]]; then
    if ! mv "$APP_DEST" "$staging/previous"; then
      rm -rf "$staging"
      echo "Could not replace $APP_DEST. The existing app is unchanged." >&2
      exit 1
    fi
  fi
  if ! mv "$staging/new" "$APP_DEST"; then
    if [[ -e "$staging/previous" || -L "$staging/previous" ]] &&
       ! mv "$staging/previous" "$APP_DEST"; then
      echo "Could not install $APP_DEST. The previous app is at $staging/previous." >&2
      exit 1
    fi
    rm -rf "$staging"
    echo "Could not install $APP_DEST." >&2
    exit 1
  fi
  SWAP_STAGING=""
  rm -rf "$staging" || echo "Warning: could not remove $staging." >&2
  echo "Installed $APP_DEST"
}

# The top-level CFBundleIdentifier of an app. Prints nothing when it cannot be
# read.
bundle_identifier_of() {
  local plist="$1/Contents/Info.plist" identifier
  [[ -f "$plist" ]] || return 0
  if identifier="$("$PLIST_BUDDY" -c 'Print :CFBundleIdentifier' "$plist" 2>/dev/null)"; then
    printf '%s' "$identifier"
  fi
}

# Links into REPLACED_APPS belong to this installation: each app there is being
# removed, or is already gone.
points_into_replaced_app() {
  local app
  for app in ${REPLACED_APPS[@]+"${REPLACED_APPS[@]}"}; do
    [[ "$1" != "$app/Contents/MacOS/"* ]] || return 0
  done
  return 1
}

if [[ -n "$FROM_DIR" ]]; then
  # A release's own installer carries its tag; a checkout's copy knows none.
  EXPECTED_TAG=""
  [[ "$CHANNEL" != "$DEFAULT_CHANNEL" ]] || EXPECTED_TAG="$DEFAULT_TAG"
else
  [[ -n "$TAG" ]] || TAG="$(resolve_latest_tag)"
  EXPECTED_TAG="$TAG"
fi

mkdir -p "$PREFIX" "$BIN_DIR"
PREFIX="$(cd "$PREFIX" && pwd -L)"
BIN_DIR="$(cd "$BIN_DIR" && pwd -L)"
APPIMAGE_DEST="$PREFIX/$APPIMAGE_NAME.AppImage"
SIDE_BIN_DIR="$PREFIX/bin"

if [[ "$OS" == "linux" ]]; then
  mkdir -p "$SIDE_BIN_DIR"

  if [[ "$HEADLESS" == "0" ]]; then
    fetch_asset "$APPIMAGE_ASSET" "$TMP_DIR/$APPIMAGE_ASSET"
  fi
  fetch_asset "$CLI_ASSET" "$TMP_DIR/$CLI_NAME"
  fetch_asset "$GLOBAL_CLI_ASSET" "$TMP_DIR/nteract-cli"
  fetch_asset "$DAEMON_ASSET" "$TMP_DIR/$DAEMON_NAME"
  fetch_asset "$MCP_ASSET" "$TMP_DIR/$MCP_NAME"
  verify_downloads

  if [[ "$HEADLESS" == "0" ]]; then
    atomic_install "$TMP_DIR/$APPIMAGE_ASSET" "$APPIMAGE_DEST"
  fi
  atomic_install "$TMP_DIR/$CLI_NAME" "$SIDE_BIN_DIR/$CLI_NAME"
  atomic_install "$TMP_DIR/nteract-cli" "$SIDE_BIN_DIR/nteract-cli"
  atomic_install "$TMP_DIR/$DAEMON_NAME" "$SIDE_BIN_DIR/$DAEMON_NAME"
  atomic_install "$TMP_DIR/$MCP_NAME" "$SIDE_BIN_DIR/$MCP_NAME"

  RUNT_BIN="$SIDE_BIN_DIR/$CLI_NAME"
  GLOBAL_CLI_BIN="$SIDE_BIN_DIR/nteract-cli"
  DAEMON_BIN="$SIDE_BIN_DIR/$DAEMON_NAME"
  MCP_BIN="$SIDE_BIN_DIR/$MCP_NAME"
else
  # macOS: the signed .app bundle is the only artifact; it carries the
  # runt/runtimed/nteract-mcp sidecars in Contents/MacOS. Desktop installs
  # place it in an Applications directory, where Finder, Spotlight, and the
  # channel's app-launch candidates look; headless installs keep it under the
  # prefix so a workstation box never grows an Applications entry.
  fetch_asset "$BUNDLE_ASSET" "$TMP_DIR/$BUNDLE_ASSET"
  verify_downloads
  if [[ "$HEADLESS" == "0" ]]; then
    install_app_bundle "$TMP_DIR/$BUNDLE_ASSET" "$APPLICATIONS_DIR"
  else
    install_app_bundle "$TMP_DIR/$BUNDLE_ASSET" "$PREFIX"
  fi

  MACOS_BIN="$APP_DEST/Contents/MacOS"
  RUNT_BIN="$MACOS_BIN/runt"
  GLOBAL_CLI_BIN="$MACOS_BIN/nteract-cli"
  DAEMON_BIN="$MACOS_BIN/runtimed"
  MCP_BIN="$MACOS_BIN/nteract-mcp"
fi

# A default macOS install keeps one copy per channel, so it retires those in
# ~/Applications. Only a real bundle in a real directory with this channel's
# identifier qualifies. Anything reached through a symlink stays, as does the
# installed app reached by another path.
REPLACED_APPS=()
OLD_APPS=()
if [[ "$DEFAULT_APPLICATIONS_DIR" == "1" ]]; then
  user_apps="${HOME%/}/Applications"
  names=("$APP_BASENAME")
  # Names older Nightly releases installed under; app lookup still finds them.
  [[ "$CHANNEL" != "nightly" ]] || names+=("nteract-nightly.app" "nteract (Nightly).app")
  for name in "${names[@]}"; do
    candidate="$user_apps/$name"
    if [[ ! -e "$candidate" && ! -L "$candidate" ]]; then
      REPLACED_APPS+=("$candidate")
    elif [[ "$candidate" -ef "$APP_DEST" ]]; then
      :
    elif [[ ! -L "$user_apps" && ! -L "$candidate" &&
            "$(bundle_identifier_of "$candidate")" == "$BUNDLE_ID" ]]; then
      REPLACED_APPS+=("$candidate")
      OLD_APPS+=("$candidate")
    else
      echo "Note: kept $candidate. It is reached through a symlink or is not a $BUNDLE_ID app. If it is an old nteract copy, remove it yourself." >&2
    fi
  done
fi

# The app has its own command so CLI `open` cannot recurse into itself.
if [[ "$OS" == "linux" && -f "$APPIMAGE_DEST" ]]; then
  DESKTOP_NAME="nteract-desktop"
  DESKTOP_LAUNCHER="$APPIMAGE_DEST"
  [[ "$CHANNEL" == "nightly" ]] && DESKTOP_NAME="nteract-desktop-nightly"
  if [[ ! -e "$BIN_DIR/$DESKTOP_NAME" && ! -L "$BIN_DIR/$DESKTOP_NAME" ]] ||
     [[ -L "$BIN_DIR/$DESKTOP_NAME" && "$(readlink "$BIN_DIR/$DESKTOP_NAME")" == "$APPIMAGE_DEST" ]]; then
    ln -sfn "$APPIMAGE_DEST" "$BIN_DIR/$DESKTOP_NAME"
    DESKTOP_LAUNCHER="$BIN_DIR/$DESKTOP_NAME"
    echo "Linked $BIN_DIR/$DESKTOP_NAME -> $APPIMAGE_DEST"
  else
    echo "Preserved existing $BIN_DIR/$DESKTOP_NAME; app available at $APPIMAGE_DEST" >&2
  fi
fi

# The marker records ownership, not a channel preference inferred from the
# most recently updated app. A custom prefix or Applications directory remains
# recognizable without trusting arbitrary links ending in 'nteract-cli'.
GLOBAL_CLI_LINK="$BIN_DIR/nteract"
GLOBAL_CLI_MARKER="$BIN_DIR/.nteract-cli-target"
CHANNEL_CLI_MARKER="$BIN_DIR/.nteract-cli-$CHANNEL-target"
previous_target=""
[[ ! -f "$GLOBAL_CLI_MARKER" ]] || IFS= read -r previous_target < "$GLOBAL_CLI_MARKER" || true
previous_channel_target=""
[[ ! -f "$CHANNEL_CLI_MARKER" ]] || IFS= read -r previous_channel_target < "$CHANNEL_CLI_MARKER" || true
current_target=""
[[ ! -L "$GLOBAL_CLI_LINK" ]] || current_target="$(readlink "$GLOBAL_CLI_LINK")"
select_cli=0
managed_cli=1
if [[ ! -e "$GLOBAL_CLI_LINK" && ! -L "$GLOBAL_CLI_LINK" ]]; then
  select_cli=1
elif [[ -n "$current_target" && "$current_target" == "$GLOBAL_CLI_BIN" ]]; then
  select_cli=1
elif points_into_replaced_app "$current_target"; then
  select_cli=1
elif [[ "$OS" == "linux" && "$CHANNEL" == "stable" && "$current_target" == "$APPIMAGE_DEST" ]]; then
  # Migrate only the exact legacy stable AppImage alias owned by this prefix.
  select_cli=1
elif [[ -n "$previous_target" && "$current_target" == "$previous_target" ]]; then
  if [[ "$DEFAULT_CLI" == "1" || "$current_target" == "$previous_channel_target" ]]; then
    select_cli=1
  else
    echo "Keeping nteract selected at $current_target. Use --default-cli to select this installation."
  fi
else
  managed_cli=0
  echo "Preserved existing $GLOBAL_CLI_LINK. CLI available at $GLOBAL_CLI_BIN." >&2
  echo "Move the existing command yourself before rerunning with --default-cli." >&2
fi
if [[ "$select_cli" == "1" ]]; then
  ln -sfn "$GLOBAL_CLI_BIN" "$GLOBAL_CLI_LINK"
  printf '%s\n' "$GLOBAL_CLI_BIN" > "$GLOBAL_CLI_MARKER.new"
  mv -f "$GLOBAL_CLI_MARKER.new" "$GLOBAL_CLI_MARKER"
  echo "Linked $GLOBAL_CLI_LINK -> $GLOBAL_CLI_BIN"
fi
printf '%s\n' "$GLOBAL_CLI_BIN" > "$CHANNEL_CLI_MARKER.new"
mv -f "$CHANNEL_CLI_MARKER.new" "$CHANNEL_CLI_MARKER"
install_compatibility_link() {
  local name="$1" target="$2"
  local link="$BIN_DIR/$name" record="$BIN_DIR/.nteract-legacy-$name-target"
  local previous="" current=""
  [[ ! -f "$record" ]] || IFS= read -r previous < "$record" || true
  [[ ! -L "$link" ]] || current="$(readlink "$link")"
  if [[ -e "$link" || -L "$link" ]]; then
    if [[ -z "$current" ]] ||
       { [[ "$current" != "$target" && ( -z "$previous" || "$current" != "$previous" ) ]] &&
         ! points_into_replaced_app "$current"; }; then
      echo "Preserved existing $link. Installed backend available at $target." >&2
      return
    fi
  fi
  ln -sfn "$target" "$link"
  printf '%s\n' "$target" > "$record.new"
  mv -f "$record.new" "$record"
  echo "Linked $link -> $target"
}
install_compatibility_link "$CLI_NAME" "$RUNT_BIN"
install_compatibility_link "$DAEMON_NAME" "$DAEMON_BIN"
install_compatibility_link "$MCP_NAME" "$MCP_BIN"

if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
  echo "Note: $BIN_DIR is not on PATH for this shell. Add it to use the nteract command directly." >&2
fi

# Remove the old copy before doctor runs: when both copies are the same
# version, doctor moves the daemon service only if its binary is gone.
for old_app in ${OLD_APPS[@]+"${OLD_APPS[@]}"}; do
  if rm -rf "$old_app"; then
    echo "Removed the older copy at $old_app"
  else
    echo "Warning: could not remove $old_app. Remove it so only $APP_DEST remains." >&2
  fi
done

# Links this run does not manage, such as a system-wide command or one left
# from another --bin-dir, are reported rather than changed.
if [[ "$DEFAULT_APPLICATIONS_DIR" == "1" ]]; then
  IFS=: read -r -a path_dirs <<< "$PATH"
  scanned=":"
  for link_dir in "${HOME%/}/.local/bin" "$SYSTEM_BIN_DIR" ${path_dirs[@]+"${path_dirs[@]}"}; do
    [[ -n "$link_dir" && "$scanned" != *":$link_dir:"* ]] || continue
    scanned="$scanned$link_dir:"
    for link in "$link_dir"/*; do
      [[ -L "$link" && ! -e "$link" ]] || continue
      link_target="$(readlink "$link")"
      points_into_replaced_app "$link_target" || continue
      echo "Warning: $link points into a removed app. Repoint it, with sudo if needed:" >&2
      echo "  ln -sfn \"$APP_DEST/Contents/MacOS/${link_target##*/}\" \"$link\"" >&2
    done
  done
fi

# Avoid accidentally installing a per-worktree dev daemon when the installer is
# run from a checkout with RUNTIMED_DEV set (common for contributors/agents).
RUNT_DIR="$(dirname "$RUNT_BIN")"
if [[ "$HEADLESS" == "0" ]]; then
  DOCTOR_ARGS=(daemon doctor --fix)
  if [[ "$NO_START" == "1" ]]; then
    DOCTOR_ARGS+=(--no-start)
  fi
  echo "Repairing daemon service with $RUNT_BIN ${DOCTOR_ARGS[*]}"
  env -u RUNTIMED_DEV -u RUNTIMED_WORKSPACE_PATH PATH="$RUNT_DIR:$BIN_DIR:$PATH" \
    "$RUNT_BIN" "${DOCTOR_ARGS[@]}"

  # doctor reports a failed repair but exits 0, so check the one outcome that
  # would leave the service launching a removed binary.
  if [[ "$DEFAULT_APPLICATIONS_DIR" == "1" ]]; then
    launch_label="io.nteract.runtimed"
    [[ "$CHANNEL" != "nightly" ]] || launch_label="io.nteract.runtimed.nightly"
    launch_agent="${HOME%/}/Library/LaunchAgents/$launch_label.plist"
    for replaced in ${REPLACED_APPS[@]+"${REPLACED_APPS[@]}"}; do
      if [[ -f "$launch_agent" ]] && grep -qF "<string>$replaced/Contents/MacOS/" "$launch_agent"; then
        echo "The daemon service in $launch_agent still points into $replaced, which was removed." >&2
        echo "Make that file writable, then run: \"$RUNT_BIN\" daemon doctor --fix" >&2
        exit 1
      fi
    done
  fi
fi

echo
echo "nteract $CHANNEL install complete."
if [[ "$OS" == "linux" && -f "$APPIMAGE_DEST" ]]; then
  echo "AppImage: $APPIMAGE_DEST"
  echo "Launcher: $DESKTOP_LAUNCHER"
elif [[ "$HEADLESS" == "0" ]]; then
  echo "App:      $APP_DEST"
fi
echo "CLI:      $GLOBAL_CLI_BIN"
echo "Command:  $GLOBAL_CLI_LINK"
echo "Daemon:   $DAEMON_BIN"
echo "MCP:      $MCP_BIN"
# Printed hints address the public command. When this install owns the shared
# `nteract` link, scope it to this channel; otherwise point at the backend.
CLI_INVOCATION="\"$GLOBAL_CLI_BIN\""
if [[ "$managed_cli" == "1" ]]; then
  CLI_INVOCATION="\"$GLOBAL_CLI_LINK\" --channel $CHANNEL"
fi
if [[ "$HEADLESS" == "1" ]]; then
  echo "CLI-only install: no daemon service was installed, repaired, or started."
elif [[ "$NO_START" == "1" ]]; then
  echo "Daemon was installed/repaired but not started (--no-start). Start with: $CLI_INVOCATION daemon start"
else
  env -u RUNTIMED_DEV -u RUNTIMED_WORKSPACE_PATH PATH="$RUNT_DIR:$BIN_DIR:$PATH" \
    "$RUNT_BIN" daemon status || true
fi
if [[ "$HEADLESS" == "1" ]]; then
  echo
  echo "Headless workstation install. To offer this machine's compute to a hosted"
  echo "notebook, mint a pairing code from the notebook's workstation panel, then:"
  echo "  $CLI_INVOCATION workstation connect <your-hosted-nteract-url> --code <code>"
  if [[ "$OS" == "linux" ]]; then
    echo "  $CLI_INVOCATION workstation service install --start"
    echo "For tmux/manual testing, foreground mode still works:"
    echo "  $CLI_INVOCATION workstation run"
  else
    echo "For macOS/non-systemd hosts, keep the foreground process running:"
    echo "  $CLI_INVOCATION workstation run"
    echo "Persistent workstation service management starts with Linux user systemd."
  fi
  echo "(Releases without 'nteract workstation' can use the cloud-runtime-agent flow"
  echo "in docs/runbooks/remote-workstation.md.)"
fi
